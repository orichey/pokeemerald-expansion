	faceplayer
    if(flag(FLAG_MYTH_EXPLAINED) == FALSE){
	    msgbox(format("Brrr... Why do I live here?\pIt's so cold!"))
    }
    if(flag(FLAG_MYTH_EXPLAINED) == TRUE){
        msgbox(format("How can it be getting warmer? I'm still so chilly!"))
    }
	closemessage
	applymovement(2, Common_Movement_FaceOriginalDirection)
	waitmovement(0)
	release
	end
}

