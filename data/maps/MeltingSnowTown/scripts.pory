script MeltingSnowTown_EventScript_LittleBoy1{
	lock
	faceplayer
    if(flag(FLAG_MYTH_EXPLAINED) == FALSE){
	    msgbox(format("Our elder promised to tell us a story. I can't wait!"))
    }
    if(flag(FLAG_MYTH_EXPLAINED) == TRUE){
        msgbox(format("I used to play in the forest all the time! I hope I don't get sick!"))
    }
	closemessage
	applymovement(4, Common_Movement_FaceOriginalDirection)
	waitmovement(0)
	release
	end
}

script MeltingSnowTown_EventScript_LittleBoy2{
	lock
	faceplayer
    if(flag(FLAG_MYTH_EXPLAINED) == FALSE){
	    msgbox(format("This pond used to be frozen over. I loved skating on the ice!"))
    }
    if(flag(FLAG_MYTH_EXPLAINED) == TRUE){
        msgbox(format("If it keeps warming up, maybe this pond will become a hot spring!"))
    }
	closemessage
	applymovement(5, Common_Movement_FaceOriginalDirection)
	waitmovement(0)
	release
	end
}

script MeltingSnowTown_EventScript_Fisherman{
	lock
	faceplayer
    if(flag(FLAG_MYTH_EXPLAINED) == FALSE){
	    msgbox(format("Whenever I wanted to fish, I had to drill a hole in the ice.\pFor some reason, the ice is gone!"))
    }
    if(flag(FLAG_MYTH_EXPLAINED) == TRUE){
        msgbox(format("After the water warmed up, I haven't had any success fishing. \pIt seems that aquatic Pokémon had adapted to their environment and couldn't survive the drastic change."))
    }
	closemessage
	applymovement(9, Common_Movement_FaceOriginalDirection)
	waitmovement(0)
	release
	end
}

script MeltingSnowTown_EventScript_Elder{
	lock
	faceplayer
    if(flag(FLAG_MYTH_EXPLAINED) == FALSE){
	    msgbox(format("Hello, child, welcome to our wintry oasis.\pYou are just in time to see the green grass emerge from the cold, which we haven't witnessed for generations."))
    }
    if(flag(FLAG_MYTH_EXPLAINED) == TRUE){
        msgbox(format("Please, for your own safety, do not enter the forest."))
    }
	closemessage
	applymovement(1, Common_Movement_FaceOriginalDirection)
	waitmovement(0)
	release
	end
}

