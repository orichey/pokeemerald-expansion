raw`
MeltingSnowTown_MapScripts::
    map_script MAP_SCRIPT_ON_TRANSITION, MeltingSnowTown_OnTransition
    .byte 0

MeltingSnowTown_OnTransition:
    call_if_set FLAG_MYTH_EXPLAINED, MeltingSnowTown_EventScript_RelocateEveryone
    end
`

script MeltingSnowTown_EventScript_RelocateEveryone{
    setobjectxyperm(10, 11, 12)
    addobject(10)
    SetObjectMovementType(10, MOVEMENT_TYPE_WANDER_AROUND)
    setobjectxyperm(3, 15, 6)
    addobject(3)
    SetObjectMovementType(3, MOVEMENT_TYPE_WANDER_AROUND)
    setobjectxyperm(4, 24, 10)
    addobject(4)
    SetObjectMovementType(4, MOVEMENT_TYPE_WANDER_AROUND)
    setobjectxyperm(2, 24, 6)
    addobject(2)
    SetObjectMovementType(2, MOVEMENT_TYPE_WANDER_AROUND)
    setflag(FLAG_RELOCATE)
}

script MeltingSnowTown_EventScript_MythTop{
    lock
    applymovement(1, Common_Movement_WalkInPlaceDown)
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceRight)
    waitmovement(0)
    special(SpawnCameraObject)
    waitmovement(0)
    delay(30)
    msgbox(format("Thank you all for gathering today."))
    closemessage
    delay(15)
    applymovement(3, Common_Movement_FaceRight)
    waitmovement(0)
    applymovement(5, Common_Movement_FaceUp)
    waitmovement(0)
    applymovement(6, Common_Movement_FaceUp)
    waitmovement(0)
    applymovement(2, moves(walk_down,walk_down,face_left))
    waitmovement(0)
    delay(30)
    applymovement(1, Common_Movement_WalkInPlaceRight)
    waitmovement(0)
    delay(30)
    applymovement(1, Common_Movement_WalkInPlaceLeft)
    waitmovement(0)
    delay(30)
    waitmovement(0)
    msgbox(format("Come, listen to my story."))
    closemessage
    delay(15)
    applymovement(OBJ_EVENT_ID_CAMERA, CameraToMythTop)
    waitmovement(0)
    applymovement(1, Common_Movement_WalkInPlaceDown)
    waitmovement(0)
    delay(30)
    msgbox(format("For generations, the cold of our home has given us life. \pDeep in frozen ponds, fish have been plentiful.\pIn the thickness of the forests, game populations have been steady.\pOur people have lived healthy lives, despite the seemingly harsh environment in which we reside."))
    closemessage
    delay(30)
    applymovement(1, Common_Movement_WalkInPlaceRight)
    waitmovement(0)
    delay(30)
    msgbox(format("However, that has not always been the case."))
    closemessage
    fadenewbgm(MUS_DUMMY)
    fadescreenspeed(FADE_TO_BLACK, 8)
    delay(30)
    msgbox(format("My grandmother once told me a story, passed down by her grandmother, and her grandmother before her.\pMany millenia ago, our world looked very different.\pThe forest, which has been frozen for as long as I can remember, began to defrost."))
    closemessage
    delay(60)
    warpcontinuescript(MAP_MELTING_SNOW_FOREST_FLASHBACK, 9, 30, SnowForestFlashbackTop_EventScript)
    end
}

script SnowForestFlashbackTop_EventScript{
    lockall
    hideobjectat(OBJ_EVENT_ID_PLAYER, MAP_MELTING_SNOW_FOREST_FLASHBACK)
    waitmovement(0)
    fadescreenspeed(FADE_FROM_BLACK, 8)
    waitmovement(0)
    special(SpawnCameraObject)
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_CAMERA, RightPan12)
    waitmovement(0)
    applymovement(5, moves(walk_right))
    waitmovement(0)
    delay(20)
    applymovement(5, moves(walk_down))
    waitmovement(0)
    delay(40)
    fadescreen(FADE_TO_BLACK)
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_CAMERA, FirstOffScreenCamForest)
    msgbox(format("Permafrost gave way to rivers and lakes, which carved gorges through the landscape."))
    closemessage
    waitmovement(0)
    delay(15)
    fadescreen(FADE_FROM_BLACK)
    waitmovement(0)
    setobjectxyperm(7, 32, 40)
    setobjectxyperm(6, 38, 40)
    setobjectxy(7, 32, 40)
    setobjectxy(6, 38, 40)
    addobject(6)
    waitmovement(0)
    addobject(7)
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_CAMERA, LeftPan12)
    waitmovement(0)
    delay(60)
    fadescreen(FADE_TO_BLACK)
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_CAMERA, SecondOffScreenCamForest)
    msgbox(format("As the land changed and the world warmed, something more sinister emerged."))
    closemessage
    waitmovement(0)
    delay(15)
    fadescreen(FADE_FROM_BLACK)
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_CAMERA, CameraLastMovementForest)
    waitmovement(0)
    delay(60)
    msgbox(format("Bacteria, viruses, and spores began to proliferate in the warmer climate."))
    closemessage
    applymovement(8, Common_Movement_JumpInPlaceDown)
    playse(SE_BIKE_HOP)
    waitmovement(0)
    applymovement(8, StantlerToShroom)
    waitmovement(0)
    delay(15)
    applymovement(8, Common_Movement_JumpInPlaceDown)
    playse(SE_BIKE_HOP)
    waitmovement(0)
    applymovement(8, Common_Movement_JumpInPlaceDown)
    playse(SE_BIKE_HOP)
    waitmovement(0)
    delay(30)
    applymovement(8, Common_Movement_ShoveDown)
    playse(SE_M_BITE)
    waitmovement(0)
    delay(30)
    msgbox(format("Wildlife became infected and began to act erratically."))
    closemessage
    applymovement(8, StantlerLeft3)
    waitmovement(0)
    delay(15)
    applymovement(8, Common_Movement_ShoveUp)
    playse(SE_CONTEST_CONDITION_LOSE)
    waitmovement(0)
    delay(10)
    applymovement(8, Common_Movement_ShoveDown)
    playse(SE_CONTEST_CONDITION_LOSE)
    waitmovement(0)
    delay(30)
    applymovement(8, StantlerLeft3)
    waitmovement(0)
    delay(15)
    applymovement(8, Common_Movement_ShoveLeft)
    playse(SE_CONTEST_CONDITION_LOSE)
    waitmovement(0)
    delay(15)
    applymovement(8, Common_Movement_ShoveRight)
    playse(SE_CONTEST_CONDITION_LOSE)
    waitmovement(0)
    delay(15)
    applymovement(8, StantlerLeft3)
    waitmovement(0)
    delay(15)
    applymovement(8, Common_Movement_ShoveLeft)
    playse(SE_CONTEST_CONDITION_LOSE)
    waitmovement(0)
    delay(15)
    applymovement(8, Common_Movement_ShoveRight)
    playse(SE_CONTEST_CONDITION_LOSE)
    waitmovement(0)
    delay(15)
    applymovement(8, Common_Movement_FaceDown)
    waitmovement(0)
    delay(30)
    msgbox(format("Pokémon quickly fell ill.\pIn their deteriorating state, they became far more aggressive than before exposure to the disease."))
    closemessage
    applymovement(8, Common_Movement_JumpInPlaceDown)
    playse(SE_BIKE_HOP)
    waitmovement(0)
    waitse
    playmoncry(SPECIES_STANTLER, CRY_MODE_NORMAL)
    waitmoncry
    delay(15)
    applymovement(8, moves(walk_fast_down*3))
    fadescreenspeed(FADE_TO_BLACK,1)
    delay(30)
    fadeoutbgm(0)
    setflag(FLAG_HIDE_MAP_NAME_POPUP)
    warpcontinuescript(MAP_MELTING_SNOW_TOWN, 17, 9, MeltingSnowTown_EventScript_MythTopReturn)
    release
    end
}

script MeltingSnowTown_EventScript_MythTopReturn{
    lockall
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceRight)
    waitmovement(0)
    applymovement(3, Common_Movement_FaceRight)
    waitmovement(0)
    applymovement(5, Common_Movement_FaceUp)
    waitmovement(0)
    applymovement(6, Common_Movement_FaceUp)
    waitmovement(0)
    applymovement(2, moves(walk_down,walk_down,face_left))
    waitmovement(0)
    special(SpawnCameraObject)
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_CAMERA, CameraToMythTop)
    waitmovement(0)
    fadescreenspeed(FADE_FROM_BLACK, 8)
    waitmovement(0)
    delay(60)
    msgbox(format("The Pokémon populations during this outbreak suffered immense losses.\pTheir numbers rebounded when the natural climatic cycles eventually brought the forest back to a frozen state."))
    closemessage
    applymovement(1, Common_Movement_FaceLeft)
    waitmovement(0)
    delay(30)
    applymovement(1, Common_Movement_WalkInPlaceLeft)
    msgbox(format("However, this story is no mere myth. The warming of our planet has caused the permafrost to thaw once more.\pThe spores have reappeared."))
    closemessage
    applymovement(6, Common_Movement_FaceRight)
    waitmovement(0)
    applymovement(3, Common_Movement_ExclamationMark)
    applymovement(2, Common_Movement_ExclamationMark)
    applymovement(6, Common_Movement_ExclamationMark)
    applymovement(5, Common_Movement_JumpInPlaceLeft)
    applymovement(4, Common_Movement_JumpInPlaceDown)
    playse(SE_PIN)
    waitse
    waitmovement(0)
    delay(120)
    applymovement(6, Common_Movement_FaceUp)
    applymovement(5, Common_Movement_FaceUp)
    applymovement(2, Common_Movement_FaceLeft)
    applymovement(4, Common_Movement_FaceLeft)
    applymovement(3, Common_Movement_FaceRight)
    waitmovement(0)
    delay(15)
    applymovement(1, Common_Movement_WalkInPlaceDown)
    waitmovement(0)
    delay(15)
    msgbox(format("I beg of all of you, stay out of the forest."))
    closemessage
    delay(30)
    playse(SE_PIN)
    msgbox(format("Help!\pP-please, help me!"))
    closemessage
    applymovement(3, Common_Movement_FaceLeft)
    applymovement(1, Common_Movement_FaceLeft)
    applymovement(2, Common_Movement_FaceLeft)
    applymovement(4, Common_Movement_FaceLeft)
    applymovement(5, Common_Movement_FaceLeft)
    applymovement(6, Common_Movement_FaceLeft)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceLeft)
    waitmovement(0)
    addobject(10)
    waitmovement(0)
    applymovement(10, WomanToSceneTop)
    waitmovement(0)
    delay(15)
    applymovement(10, Common_Movement_JumpInPlaceRight)
    playse(SE_BIKE_HOP)
    waitmovement(0)
    waitse
    applymovement(10, Common_Movement_JumpInPlaceRight)
    playse(SE_BIKE_HOP)
    waitmovement(0)
    waitse
    delay(15)
    msgbox(format("My daughter ran off! I can't find her!"))
    closemessage
    applymovement(10, Common_Movement_FaceUp)
    waitmovement(0)
    delay(15)
    msgbox(format("I can't go searching in the forest, I don't have any way to defend myself!"))
    closemessage
    applymovement(10, Common_Movement_FaceRight)
    waitmovement(0)
    delay(15)
    msgbox(format("Will anyone help me?"))
    closemessage
    delay(15)
    applymovement(OBJ_EVENT_ID_CAMERA, CameraFromMythTop)
    waitmovement(0)
    special(RemoveCameraObject)
    waitmovement(0)
    setobjectxyperm(10, 15, 10)
    setobjectxy(10, 15, 10)
    SetObjectMovementType(10, MOVEMENT_TYPE_LOOK_AROUND)
    waitmovement(0)
    setflag(FLAG_MYTH_EXPLAINED)
    clearflag(FLAG_HIDE_MAP_NAME_POPUP)
    setrespawn(HEAL_LOCATION_MELTING_SNOW)
    releaseall
    end
}














