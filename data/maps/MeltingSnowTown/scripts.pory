script MeltingSnowTown_EventScript_Nurse{
    lock
    faceplayer
    if(flag(FLAG_ABSOL_ENTER) == FALSE){
        msgbox(format("Oh... you don't have a Pokémon?\pCome back if you need to heal a Pokémon."))
        applymovement(8, Common_Movement_FaceOriginalDirection)
        waitmovement(0)
        release
        end
    }
    if(flag(FLAG_MELTING_SNOW_TOWN_NURSE) == TRUE){
        msgbox(format("Would you like me to heal your Pokémon?"), MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES){
            special(HealPlayerParty)
            playfanfare(MUS_HEAL)
            waitfanfare
            msgbox(format("Let me know if you need my services again."))
            waitmessage
        }
        else{
            msgbox(format("Let me know if you need my services."))
        }
    }
    if(flag(FLAG_MELTING_SNOW_TOWN_NURSE) == FALSE){
        msgbox(format("Brr... I can't believe I was assigned this post. Why couldn't I have been sent to the beach?\pAnyway...\pWould you like me to heal your Pokémon?"), MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES){
            special(HealPlayerParty)
            playfanfare(MUS_HEAL)
            waitfanfare
            msgbox(format("Let me know if you need my services again."))
            waitmessage
            setflag(FLAG_MELTING_SNOW_TOWN_NURSE)
        }
        else{
            msgbox(format("Let me know if you need my services."))
            waitmessage
            setflag(FLAG_MELTING_SNOW_TOWN_NURSE)
        }
    }
    applymovement(8, Common_Movement_FaceOriginalDirection)
    waitmovement(0)
    callnative(UpdateFollowingPokemon)
    release
    end
}

script MeltingSnowTown_EventScript_HouseWoman{
	lock
	faceplayer
    if(flag(FLAG_SNOWY_ITEMS_GIVEN) == TRUE){
        msgbox(format("That should be enough to get you started!"))
    }
    if(flag(FLAG_SNOWY_ITEMS_GIVEN) == FALSE){
	    msgbox(format("Hello, traveler! You seem to have packed light.\pHere, take these!"))
        giveitem(ITEM_ULTRA_BALL, 30)
        setflag(FLAG_SNOWY_ITEMS_GIVEN)
    }
	closemessage
	release
	end
}

movement CameraToMythTop{
    walk_right*3
    walk_diag_northeast
    step_end
}

movement CameraToMythBottom{
    walk_right*2
    walk_diag_northeast*2
    step_end
}

movement CameraFromMythTop{
    walk_diag_southwest
    walk_left*3
    step_end
}

movement CameraFromMythBottom{
    walk_diag_southwest*2
    walk_left*2
    step_end
}

movement RightPan12{
    walk_right*12
}

movement LeftPan12{
    walk_left*12
}

movement CameraLastMovementForest{
    walk_right*14
}

movement FirstOffScreenCamForest{
    walk_diag_southeast*6
    walk_faster_right*20
}

movement SecondOffScreenCamForest{
    walk_diag_northwest*5
    walk_faster_up*23
}

movement StantlerToShroom{
    walk_fast_right*9
    face_down
}

movement StantlerLeft3{
    walk_slow_left*3
}

movement WomanToSceneTop{
    walk_fast_right*6
}