script MeltingSnowForest_EventScript_WaterWoman{
    faceplayer
    if(flag(FLAG_WATER_WOMAN_TALKED) == FALSE){
        msgbox(format("I hear that new flora may be sprouting as the forest thaws, and I came here looking for flowers!\pHowever, those two Pokémon got into a fight, trapping me here.\pThank you for warding them off, you can have this!"))
        giveitem(ITEM_WAILMER_PAIL)
        setflag(FLAG_WATER_WOMAN_TALKED)
    }
    if(flag(FLAG_WATER_WOMAN_TALKED) == TRUE){
        msgbox(format("No flowers, but I did come across a berry.\pThank you again for helping me out!"))
    }
    closemessage
    applymovement(49, Common_Movement_FaceOriginalDirection)
    waitmovement(0)
    release
    end
}