script MeltingSnowForest_EventScript_WaterWoman{
    faceplayer
    if(flag(FLAG_WATER_WOMAN_TALKED) == FALSE){
        msgbox(format("I hear that new flora may be sprouting as the forest thaws, and I came here looking for flowers!\pHowever, those two Pokémon got into a fight, trapping me here.\pThank you for scaring them off, you can have this!"))
        giveitem(ITEM_WAILMER_PAIL)
        setflag(FLAG_WATER_WOMAN_TALKED)
    }
    if(flag(FLAG_WATER_WOMAN_TALKED) == TRUE){
        msgbox(format("No flowers, but I did come across a berry.\pThank you again for helping me out!"))
    }
    closemessage
    applymovement(49, Common_Movement_FaceOriginalDirection)
    waitmovement(0)
    release
    end
}





script MeltingSnowForest_EventScript_LastScientist{
	lock
    faceplayer
    if(flag(FLAG_GLALIE_FROSLASS_DOUBLE) != TRUE || flag(FLAG_HUNGRY_SENTRET) != TRUE || flag(FLAG_HUNGRY_SWINUB) != TRUE || flag(FLAG_HUNGRY_TEDDIURSA) != TRUE || flag(FLAG_STANTLER_WATERED) != TRUE || flag(FLAG_PARASECT_DOUBLE_BATTLE) != TRUE){
        if(flag(FLAG_LAST_SCIENTIST_FIRST_TALK) == FALSE){
            msgbox(format("These Pokémon are displaying irregular, aggressive behavior.\pIt seems like they've been infected by something that emerged from the frost. Perhaps the legends were true."))
            setflag(FLAG_LAST_SCIENTIST_FIRST_TALK)
        }
        msgbox(format("The Stantler show no sign of budging."))
        if(flag(FLAG_PARASECT_DOUBLE_BATTLE) == FALSE){
            msgbox(format("A pair of Pokémon were bullying a defenseless Parasect to the south.\pPerhaps the Mushroom Pokémon has something to do with this illness we're observing.\pCould you investigate?"))
            closemessage
            releaseall
            end
        }
        if(flag(FLAG_GLALIE_FROSLASS_DOUBLE) == FALSE){
            msgbox(format("I heard two Pokémon locked in a brawl, trapping a woman.\pSomeone should save her!"))
            closemessage
            releaseall
            end
        }
        if(flag(FLAG_STANTLER_WATERED) == FALSE){
            msgbox(format("Another Stantler in this forest appeared to be infected and was extremely feverish.\pCould you give it some water to see if that could help it feel better?"))
            closemessage
            releaseall
            end
        }
        if(flag(FLAG_HUNGRY_SENTRET) == FALSE || flag(FLAG_HUNGRY_SWINUB) == FALSE || flag(FLAG_HUNGRY_TEDDIURSA) == FALSE){
            msgbox(format("While probing this forest, I came across several hungry Pokémon on the brink of starvation.\pIn particular, three young Pokémon by the river looked in rough shape. Could you assist?"))
            closemessage
            releaseall
            end
        }
    }
    if(flag(FLAG_GLALIE_FROSLASS_DOUBLE) == TRUE && flag(FLAG_HUNGRY_SENTRET) == TRUE && flag(FLAG_HUNGRY_SWINUB) == TRUE && flag(FLAG_HUNGRY_TEDDIURSA) == TRUE && flag(FLAG_STANTLER_WATERED) == TRUE && flag(FLAG_PARASECT_DOUBLE_BATTLE) == TRUE){
        msgbox(format("You investigated the whole forest? Wow!\pLucky for you, those Stantler appear to have left!"))
        closemessage
        releaseall
        end
    }
    releaseall
    end
}

script MeltingSnowForest_EventScript_FightingStantler{
    msgbox(format("The Stantler is locked into combat, it does not notice you."))
    closemessage
    release
    end
}

script MeltingSnowForest_AlbedoScientist{
    faceplayer
    msgbox(format("As snow melts, dark land is exposed. These areas absorb more radiation from the sun than reflective snow, increasing the temperature of the earth.\pIn this way, global warming is a positive feedback loop!"))
    closemessage
    release
    end
}



script MeltingSnowForest_EventScript_ConservationHiker{
	trainerbattle_single(TRAINER_SHELLY_SEAFLOOR_CAVERN, Martin_Intro, Martin_Outro)
	msgbox(PostBattle_Martin, MSGBOX_AUTOCLOSE) 
	waitmessage
    end
}
text Martin_Intro{
    format("Forests like this account for one of the world's largest carbon sinks!")
}
text Martin_Outro{
    format("Boreal forests hold hundreds of billions of tons of carbon!")
}
text PostBattle_Martin{
    format("If these forests go away, the world won't be able to hold as much carbon.\pThe world will continue to heat up.")
}

script MeltingSnowForest_EventScript_RisingTemps{
	trainerbattle_single(TRAINER_ARCHIE, Anthony_Intro, Anthony_Outro)
	msgbox(PostBattle_Anthony, MSGBOX_AUTOCLOSE) 
	waitmessage
    end
}
text Anthony_Intro{
    format("This forest has warmed three times faster than anywhere else in the world!")
}
text Anthony_Outro{
    format("Ah! This battle was too hot!")
}
text PostBattle_Anthony{
    format("Polar regions like this have experienced rapid warming due to arctic amplification.\pI learned about that from a scientist!")
}

script MeltingSnowForest_EventScript_Decay{
	faceplayer
	msgbox(format("Decaying plant and animal matter from the past has been unearthed as the snow melts.\pAs this matter is exposed, methane is released, which increases the impact of the greenhouse effect.\pI don't see how this forest stands a chance of maintaining a natural equilibrium much longer."))
	closemessage
	applymovement(41, Common_Movement_FaceOriginalDirection)
	waitmovement(0)
	release
	end
}

script MeltingSnowForest_EventScript_LittleGirl{
    lockall
    setflag(FLAG_SAFE_FOLLOWER_MOVEMENT)
    special(SpawnCameraObject)
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_CAMERA, CameraToLittleGirl)
    waitmovement(0)
	delay(30)
    applymovement(29, Common_Movement_FaceUp)
    waitmovement(0)
    delay(30)
    applymovement(29, Common_Movement_FaceRight)
    waitmovement(0)
    delay(30)
    applymovement(29, Common_Movement_WalkInPlaceRight)
    waitmovement(0)
    delay(15)
    msgbox(format("So cold...\pI don't think anyone's coming..."))
	closemessage
	delay(30)
    msgbox(format("Sniffle..."))
    closemessage
    delay(15)
    applymovement(OBJ_EVENT_ID_PLAYER, PlayerToLittleGirl)
    applymovement(OBJ_EVENT_ID_FOLLOWER, PlayerToLittleGirl)
    applymovement(29, Common_Movement_FaceLeft)
    waitmovement(0)
    applymovement(29, Common_Movement_ExclamationMark)
    playse(SE_PIN)
    waitmovement(0)
    delay(60)
    applymovement(OBJ_EVENT_ID_CAMERA, CameraFromLittleGirl)
	waitmovement(0)
    special(RemoveCameraObject)
    delay(30)
    applymovement(29, Common_Movement_JumpInPlaceLeft)
    playse(SE_BIKE_HOP)
    waitmovement(0)
    delay(20)
    msgbox(format("Did you scare off those mean Stantler?\pAre you here to save me?"))
    closemessage
    delay(30)
    applymovement(29, moves(walk_in_place_left*4,walk_in_place_fast_left*4))
    waitmovement(0)
    msgbox(format("I'm sorry! I didn't mean to run off!\pI'll never do it ever again, I promise!\pI just want to go home."))
    closemessage
    delay(30)
    playmoncry(SPECIES_STANTLER, CRY_MODE_ENCOUNTER)
    waitmoncry
    applymovement(29, Common_Movement_WalkInPlaceUp)
    waitmovement(0)
    msgbox(format("Wh-what was that?"))
    closemessage
    addobject(60)
    addobject(61)
    applymovement(61, moves(walk_faster_down*7))
    waitmovement(0)
    clearflag(FLAG_SAFE_FOLLOWER_MOVEMENT)
    applymovement(61, moves(walk_fast_right*7))
    applymovement(60, moves(walk_fast_down*3,jump_down))
    delay(25)
    playse(SE_BIKE_HOP)
    waitmovement(0)
    applymovement(60, Common_Movement_JumpDown)
    playse(SE_BIKE_HOP)
    waitmovement(0)
    applymovement(60, Common_Movement_JumpDown)
    playse(SE_BIKE_HOP)
    waitmovement(0)
    applymovement(60, Common_Movement_WalkInPlaceLeft)
    waitmovement(0)
    applymovement(29, Common_Movement_FaceLeft)
    waitmovement(29)
    applymovement(61, moves(walk_in_place_right*8))
    applymovement(60, moves(walk_in_place_left*8))
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_WalkInPlaceLeft)
    waitmovement(0)
    delay(30)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_WalkInPlaceRight)
    waitmovement(0)
    waitmovement(60)
    removeobject(50)
    waitmovement(0)
    playmoncry(SPECIES_STANTLER, CRY_MODE_ENCOUNTER)
    waitmoncry
    delay(15)
    setflag(FLAG_UNUSED_0x8F7)
    setflag(FLAG_UNUSED_0x8F8)
    setwildbattle(SPECIES_STANTLER, 45, ITEM_NONE, SPECIES_STANTLER, 45, ITEM_NONE)
    applymovement(61, Common_Movement_ShoveRight)
    applymovement(60, Common_Movement_ShoveLeft)
    playse(SE_SWITCH)
    waitse
    dowildbattle
    waitmovement(0)
	delay(15)
    playmoncry(SPECIES_STANTLER, CRY_MODE_ENCOUNTER)
    waitmoncry
    delay(15)
    applymovement(61, Common_Movement_ShoveRight)
    applymovement(60, Common_Movement_ShoveLeft)
    playse(SE_SWITCH)
    waitse
    waitmovement(0)
    applymovement(61, moves(walk_fast_left*7))
    applymovement(60, Common_Movement_JumpUp)
    playse(SE_BIKE_HOP)
    delay(20)
    applymovement(60, Common_Movement_JumpUp)
    playse(SE_BIKE_HOP)
    delay(20)
    applymovement(60, Common_Movement_JumpUp)
    playse(SE_BIKE_HOP)
    delay(20)
    applymovement(60, moves(walk_fast_up*4))
    applymovement(50, moves(walk_faster_left*8))
    waitmovement(0)
    delay(30)
    setflag(FLAG_SNOW_GIRL)
    removeobject(60)
    removeobject(61)
    removeobject(50)
    waitmovement(0)
    applymovement(29, Common_Movement_JumpInPlaceLeft)
    playse(SE_BIKE_HOP)
    waitmovement(0)
    msgbox(format("They ran away!\pThose Stantler were so scary!"))
    closemessage
    delay(15)
    applymovement(29, Common_Movement_WalkLeft)
    waitmovement(0)
    msgbox(format("Let's go home!"))
    closemessage
    delay(15)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_left*6))
    applymovement(29, moves(walk_left*5))
    waitmovement(OBJ_EVENT_ID_PLAYER)
    delay(5)
    applymovement(29, Common_Movement_WalkInPlaceLeft)
    waitmovement(0)
    applymovement(29, Common_Movement_FaceLeft)
    waitmovement(0)
    delay(5)
    playse(SE_PIN)
    waitse
    delay(5)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceRight)
    waitmovement(0)
    delay(15)
    msgbox(format("Wait, I don't feel so good..."))
    closemessage
    delay(30)
    applymovement(29, Common_Movement_ShoveLeft)
    playse(SE_CONTEST_CONDITION_LOSE)
    waitmovement(0)
    delay(15)
    applymovement(29, Common_Movement_ShoveRight)
    playse(SE_CONTEST_CONDITION_LOSE)
    waitmovement(0)
    msgbox(format("Cough, cough..."))
    closemessage
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_JumpInPlaceRight)
    playse(SE_BIKE_HOP)
    waitmovement(0)
    delay(15)
    special(SpawnCameraObject)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_faster_left*2,walk_faster_down*8))
    delay(15)
    fadenewbgm(MUS_DUMMY)
    applymovement(29, Common_Movement_FaceDown)
    waitmovement(OBJ_EVENT_ID_PLAYER)
    delay(15)
    msgbox(format("Wait, please...\pDon't leave me behind..."))
    fadescreenspeed(FADE_TO_BLACK,6)
    delay(30)
    fadeoutbgm(0)
    callnative(StartCredits)
    release
    end
}

movement CameraToLittleGirl{
    walk_right*8
}

movement PlayerToLittleGirl{
    walk_right*6
}

movement CameraFromLittleGirl{
    walk_left*2
}

script MeltingSnowForest_EventScript_Chansey{
    lock
    faceplayer
    playmoncry(SPECIES_CHANSEY, CRY_MODE_NORMAL)
    msgbox(format("Chan Chan!"))
    waitmoncry
    closemessage
    special(HealPlayerParty)
    playfanfare(MUS_HEAL)
    waitfanfare
    msgbox(format("The Chansey healed your team!"))
    waitmessage
    applymovement(62, Common_Movement_FaceOriginalDirection)
    waitmovement(0)
    callnative(UpdateFollowingPokemon)
    release
    end
}