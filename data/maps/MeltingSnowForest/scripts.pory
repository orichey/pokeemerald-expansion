script MeltingSnowForest_EventScript_Froslass{
	lock
	faceplayer
    setflag(FLAG_SAFE_FOLLOWER_MOVEMENT)
    applymovement(48, Common_Movement_FacePlayer)
    delay(30)
	playmoncry(SPECIES_FROSLASS, CRY_MODE_ENCOUNTER)
	waitmoncry
    delay(30)
    applymovement(47, Common_Movement_ShoveRight)
    playse(SE_SWITCH)
    waitmovement(0)
    delay(30)
	msgbox(format("The Pokémon furiously attacked!"))
    setflag(FLAG_UNUSED_0x8F7)
    setflag(FLAG_UNUSED_0x8F8)
	setwildbattle(SPECIES_FROSLASS, 35, ITEM_NONE, SPECIES_GLALIE, 35, ITEM_NONE)
	dowildbattle
	waitmovement(0)
	delay(15)
    clearflag(FLAG_SAFE_FOLLOWER_MOVEMENT)
    callnative(UpdateFollowingPokemon)
    waitmovement(0)
    applymovement(48, Common_Movement_FaceUp)
    applymovement(47, Common_Movement_FaceDown)
    waitmovement(0)
    delay(15)
    applymovement(48, Common_Movement_ShoveUp)
    applymovement(47, Common_Movement_ShoveDown)
    playse(SE_M_BITE)
    waitmovement(0)
    delay(15)
    applymovement(48, moves(walk_fast_right*9))
    delay(15)
    applymovement(47, moves(walk_fast_down,walk_fast_right*9))
    waitmovement(0)
	playse(SE_EXIT)
	waitse
    removeobject(48)
    removeobject(47)
	setflag(FLAG_GLALIE_FROSLASS_DOUBLE)
    if(flag(FLAG_GLALIE_FROSLASS_DOUBLE) == TRUE && flag(FLAG_HUNGRY_SENTRET) == TRUE && flag(FLAG_HUNGRY_SWINUB) == TRUE && flag(FLAG_HUNGRY_TEDDIURSA) == TRUE && flag(FLAG_STANTLER_WATERED) == TRUE && flag(FLAG_PARASECT_DOUBLE_BATTLE) == TRUE){
       setflag(FLAG_CLEAR_STANTLERS)
    }
	waitmovement(0)
	releaseall
	end
}

