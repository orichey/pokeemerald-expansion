movement AbsolDownTop{
	walk_fast_down*3
    jump_2_down
    walk_fast_down*3
}

movement AbsolDownTopMiddle{
	walk_fast_down*3
    jump_2_down
    walk_fast_down*4
}

movement AbsolDownBottomMiddle{
	walk_fast_down*3
    jump_2_down
    walk_fast_down*5
}

movement AbsolDownBottom{
	walk_fast_down*3
    jump_2_down
    walk_fast_down*6
}

movement AbsolJump{
	jump_in_place_right*2
}

script Ranch_EventScript_ThirstyBoy{
	lock
	faceplayer
	msgbox(format("Water...\nDo you have water?\pI haven't had a drink in ages..."))
	closemessage
	applymovement(5, Common_Movement_FaceOriginalDirection)
	waitmovement(0)
	release
	end
}

script Ranch_EventScript_FarmerSpeechTop{
    lockall
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceLeft)
    waitmovement(0)
    setflag(FLAG_SAFE_FOLLOWER_MOVEMENT)
    special(SpawnCameraObject)
    applymovement(OBJ_EVENT_ID_CAMERA, CameraToFarmerFirst)
    waitmovement(0)
    applymovement(6, Common_Movement_WalkInPlaceDown)
    waitmovement(0)
    msgbox(format("Ahem, excuse me, everybody."))
    waitmovement(0)
	closemessage
    delay(10)
    applymovement(9, Common_Movement_FaceUp)
    waitmovement(0)
    delay(10)
    applymovement(11, Common_Movement_FaceUp)
    waitmovement(0)
    delay(10)
    applymovement(16, Common_Movement_FaceUp)
    waitmovement(0)
    delay(30)
    applymovement(6, Common_Movement_WalkInPlaceDown)
    waitmovement(0)
    msgbox(format("Erm... I know today was supposed to be our annual Harvest Festival."))
    waitmovement(0)
	closemessage
    delay(30)
    applymovement(6, Common_Movement_WalkInPlaceLeft)
    waitmovement(0)
    delay(30)
    msgbox(format("A day to celebrate the work we put in all year, with dancing, singing, and, of course, our feast."))
    waitmovement(0)
    closemessage
    delay(30)
    applymovement(6, Common_Movement_WalkInPlaceDown)
    waitmovement(0)
    msgbox(format("Unfortunately, the ceremony has been cancelled this year."))
    waitmovement(0)
    closemessage
    applymovement(16, Common_Movement_ExclamationMark)
	applymovement(9, Common_Movement_ExclamationMark)
	applymovement(11, Common_Movement_ExclamationMark)
    applymovement(12, Common_Movement_ExclamationMark)
	applymovement(15, Common_Movement_ExclamationMark)
	waitmovement(0)
	applymovement(16, Common_Movement_FaceLeft)
	waitmovement(0)
	applymovement(11, Common_Movement_FaceDown)
	waitmovement(0)
	applymovement(9, Common_Movement_FaceRight)
    waitmovement(0)
	applymovement(12, Common_Movement_FaceRight)
	waitmovement(0)
	applymovement(15, Common_Movement_FaceLeft)
	waitmovement(0)
    playse(SE_PIN)
    waitse
	delay(120)
	applymovement(16, Common_Movement_FaceUp)
	applymovement(11, Common_Movement_FaceUp)
	applymovement(9, Common_Movement_FaceUp)
    applymovement(12, Common_Movement_FaceUp)
	applymovement(15, Common_Movement_FaceUp)
	waitmovement(0)
    delay(60)
    applymovement(6, Common_Movement_WalkInPlaceDown)
    waitmovement(0)
    msgbox(format("Believe me, I am just as disappointed as the rest of you.\pThe truth is, our farm has not had access to water over the past year.\pNo rain, the river hasn't flowed in years, and our wells appear to have dried up."))
    waitmovement(0)
	closemessage
    delay(30)
    applymovement(6, Common_Movement_WalkInPlaceLeft)
    waitmovement(0)
    delay(30)
    msgbox(format("If things don't change, this might be our last time gathering like this...\pI'm sorry I failed you."))
    closemessage
    waitmovement(0)
    delay(60)
    waitmovement(0)
    msgbox(format("I hear this farm has been experiencing a drought?"))
    closemessage
    applymovement(6, Common_Movement_ExclamationMark)
    waitmovement(0)
    applymovement(10, Common_Movement_FaceRight)
    applymovement(9, Common_Movement_FaceRight)
    applymovement(16, Common_Movement_FaceRight)
    applymovement(8, Common_Movement_FaceRight)
    applymovement(11, Common_Movement_FaceRight)
    applymovement(12, Common_Movement_FaceRight)
    applymovement(15, Common_Movement_FaceRight)
    applymovement(14, Common_Movement_FaceRight)
    applymovement(6, Common_Movement_FaceRight)
    applymovement(7, Common_Movement_FaceRight)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceRight)
    applymovement(OBJ_EVENT_ID_FOLLOWER, Common_Movement_FaceRight)
    waitmovement(0)
    delay(30)
    waitmovement(0)
    addobject(39)
    waitmovement(0)
	setobjectxy(39, 56, 67)
    waitmovement(0)
    applymovement(39, GentlemanToScene)
    applymovement(OBJ_EVENT_ID_CAMERA, CameraToGentleman)
    waitmovement(0)
    msgbox(format("My best scientists and engineers have been studying the hydrology of this area, and we know how to bring back prosperity.\pFarmers, if you implement our technological solutions, your harvest will be more abundant than ever next year."))
    closemessage
    waitmovement(0)
    delay(60)
    waitmovement(0)
	setobjectxy(36, 52, 74)
    waitmovement(0)
    setobjectxy(37, 53, 74)
    waitmovement(0)
    setobjectxy(38, 54, 74)
    waitmovement(0)
    msgbox(format("Your technology will never work!"))
    closemessage
    waitmovement(0)
    applymovement(36, ConfrontGentleman1)
    applymovement(37, ConfrontGentleman1)
    applymovement(38, ConfrontGentleman2)
    waitmovement(0)
    applymovement(39, Common_Movement_FaceDown)
    applymovement(39, Common_Movement_ExclamationMark)
    delay(15)
    waitmovement(0)
    applymovement(37, Common_Movement_WalkInPlaceFasterUp)
    waitmovement(0)
    delay(15)
    msgbox(format("We've heard what you're planning!\nYour ideas will just make matters worse!"))
    closemessage
    waitmovement(0)
    delay(30)
    applymovement(39, Common_Movement_FaceLeft)
    waitmovement(0)
    delay(60)
    applymovement(39, Common_Movement_FaceDown)
    waitmovement(0)
    delay(90)
    applymovement(39, Common_Movement_WalkInPlaceDown)
    waitmovement(0)
    msgbox(format("I assure you, my solutions are sound. However, if you are so concerned, I implore you to look at who has joined us today."))
    closemessage
    waitmovement(0)
    applymovement(39, Common_Movement_FaceLeft)
    applymovement(OBJ_EVENT_ID_CAMERA, ToAbsolTop)
    waitmovement(0)
    msgbox(format("As I'm sure you are aware, Absol has foresight of disasters, including those plaguing this region. This particular Absol seems to be united with this trainer. \pWhy don't we take their input into account?"))
    closemessage
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_CAMERA, FromAbsolTop)
    waitmovement(0)
    applymovement(39, Common_Movement_WalkInPlaceDown)
    waitmovement(0)
    msgbox(format("I will tell all the farmers of my plans. Of course, they may consult with the Absol and this trainer, as well as with you hooligans."))
    closemessage
    waitmovement(0)
    applymovement(39, Common_Movement_FaceLeft)
    delay(60)
    msgbox(format("You may take my help, or leave it. The choice is yours."))
    closemessage
    waitmovement(0)
    delay(30)
    fadescreenswapbuffers(FADE_TO_BLACK)
	playse(SE_EXIT)
    applymovement(OBJ_EVENT_ID_CAMERA, ToPlayerTop)
    waitmovement(0)
    delay(90)
    special(RemoveCameraObject)
    waitmovement(0)
    removeobject(36)
    removeobject(37)
    removeobject(38)
    removeobject(32)
    removeobject(33)
    removeobject(34)
    removeobject(35)
    removeobject(39)
    waitmovement(0)
    applymovement(6, Common_Movement_FaceOriginalDirection)
    applymovement(11, Common_Movement_FaceOriginalDirection)
    applymovement(9, Common_Movement_FaceOriginalDirection)
    applymovement(16, Common_Movement_FaceOriginalDirection)
    applymovement(12, Common_Movement_FaceOriginalDirection)
    applymovement(15, Common_Movement_FaceOriginalDirection)
    applymovement(7, Common_Movement_FaceOriginalDirection)
    setobjectxyperm(39, 58, 68)
    addobject(39)
    fadescreenswapbuffers(FADE_FROM_BLACK)
    setflag(FLAG_FARMER_SPEECH)
    setrespawn(HEAL_LOCATION_RANCH)
    releaseall
    end
}


