movement FarmerMadInPlaceRight{
    walk_in_place_fast_right*3
    walk_in_place_faster_right*5
}

movement ProtestorMadInPlaceLeft{
    walk_in_place_fast_left*3
    walk_in_place_faster_left*5
}

movement Farmer2ToRight{
    walk_fast_down
    face_right
}

movement Protestor2ToLeft{
    walk_fast_down
    walk_fast_left*2
    face_up
}

movement Protestor2Down{
    walk_fast_down
    face_left
}

script Ranch_EventScript_NativeEncounterFarmer{
    if(flag(FLAG_FARMER3_BATTLE) == FALSE){
        lock
        applymovement(17, Common_Movement_WalkInPlaceFastDown)
        waitmovement(0)
        delay(15)
        msgbox(format("We've farmed hay here for decades. You kids aren't gonna change that now!"))
        closemessage
        delay(15)
        applymovement(18, Common_Movement_WalkInPlaceFastUp)
        delay(15)
        msgbox(format("I understand, but your practices aren't sustainable. There are other methods that have worked here for millenia that don't require irrigation!"))
        closemessage
        delay(15)
        applymovement(17, Common_Movement_WalkInPlaceFastDown)
        waitmovement(0)
        delay(15)
        msgbox(format("That's crazy talk. Who could grow without water?"))
        closemessage
        delay(15)
        applymovement(18, Common_Movement_WalkInPlaceFastUp)
        delay(15)
        msgbox(format("The native people who have been here long before your people. Why don't you give their practices a shot?"))
        closemessage
        delay(15)
        faceplayer
        msgbox(format("What makes sense to you? Traditional farming, or irrigated farming?"))
        dynmultichoice(0, 0, TRUE, 2, 0, DYN_MULTICHOICE_CB_NONE, "Traditional!", "Irrigated!")
        if (var(VAR_RESULT) == 0){
            applymovement(18, Common_Movement_LockFacingDirection)
            waitmovement(0)
            applymovement(17, FarmerMadInPlaceDown)
            waitmovement(0)
            delay(15)
            msgbox(format("Why are you trying to make us change?"))
            closemessage
            getplayerxy(VAR_TEMP_0, VAR_TEMP_1)
            if (var(VAR_TEMP_0) == 36 && var(VAR_TEMP_1) == 48){
                applymovement(17, Common_Movement_FacePlayer)
            }
            if (var(VAR_TEMP_0) == 37 && var(VAR_TEMP_1) == 49){
                applymovement(17, Common_Movement_FacePlayer)
            }
            if (var(VAR_TEMP_0) == 37 && var(VAR_TEMP_1) == 50){
                applymovement(17, Farmer3ToRight)
                waitmovement(0)
                applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceUp)
            }
            if (var(VAR_TEMP_0) == 36 && var(VAR_TEMP_1) == 51){
                applymovement(17, Farmer3ToBottom)
                waitmovement(0)
                applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceRight)
            }
            waitmovement(0)
            trainerbattle_single(TRAINER_GRUNT_RUSTURF_TUNNEL, "We know what works!", "How are we supposed to farm without\nwatering our crops?", Ranch_EventScript_ThirdFarmerLeave)
        }
        if (var(VAR_RESULT) == 1){
            applymovement(17, Common_Movement_LockFacingDirection)
            waitmovement(0)
            applymovement(18, ProtestorMadInPlaceUp)
            waitmovement(0)
            delay(15)
            msgbox(format("I know it seems hard to believe, but people have thrived for thousands of years without irrigation!"))
            closemessage
            getplayerxy(VAR_TEMP_0, VAR_TEMP_1)
            if (var(VAR_TEMP_0) == 36 && var(VAR_TEMP_1) == 51){
                applymovement(18, Common_Movement_FacePlayer)
            }
            if (var(VAR_TEMP_0) == 37 && var(VAR_TEMP_1) == 50){
                applymovement(18, Common_Movement_FacePlayer)
            }
            if (var(VAR_TEMP_0) == 37 && var(VAR_TEMP_1) == 49){
                applymovement(18, Protestor3ToRight)
                waitmovement(0)
                applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceDown)
            }
            if (var(VAR_TEMP_0) == 36 && var(VAR_TEMP_1) == 48){
                applymovement(18, Protestor3ToTop)
                waitmovement(0)
                applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceRight)
            }
            waitmovement(0)
            trainerbattle_single(TRAINER_GRUNT_WEATHER_INST_1, "Why can't you give it a shot?", "Don't you see the current method \ndoesn't work?", Ranch_EventScript_ThirdProtestorLeave)
        }
    }
    if(flag(FLAG_FARMER3_BATTLE) == TRUE){
        lock
        faceplayer
        waitmovement(0)
        msgbox(format("What was that crazy guy on about, anyway? Crops without water?\pThese city folk think they know everything."))
        closemessage
    }
    release
    end
}

