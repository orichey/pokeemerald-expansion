    waitmovement(0)
    setobjectxyperm(27, 26, 48)
    addobject(27)
    waitmovement(0)
    delay(15)
    fadescreenswapbuffers(FADE_FROM_BLACK)
    goto(Ranch_EventScript_FarmerWin7)
    release
    end
}

movement Protestor7ToLeft{
    walk_fast_down
    face_left
}

movement Farmer7ToRight{
    walk_fast_down
    face_right
}

movement FinalProtestorToScene{
    walk_fast_right*5
    walk_fast_up*2
    walk_fast_right*3
    face_up
}

movement LastProtestorFromScene{
    walk_fast_left*3
    walk_fast_down*2
    walk_fast_left*5
}



script Ranch_EventScript_FinalEncounter{
    lock
    msgbox(format("Hey! Are you the one running this place?"))
    closemessage
    applymovement(6, Common_Movement_ExclamationMark)
    waitmovement(0)
    applymovement(6, Common_Movement_FaceLeft)
    waitmovement(0)
    getplayerxy(VAR_TEMP_2, VAR_TEMP_3)
        if (var(VAR_TEMP_2) == 47 && var(VAR_TEMP_3) == 67){
            applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_WalkRight)
            waitmovement(0)
            applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceLeft)
        }
    addobject(42)
    waitmovement(0)
	setobjectxy(42, 39, 69)
    waitmovement(0)
    delay(15)
    applymovement(42, FinalProtestorToScene)
    waitmovement(0)
    delay(30)
    if(var(VAR_RANCH_MORALITY_SYSTEM) > 10){
        applymovement(6, Common_Movement_FaceDown)
        waitmovement(0)
        delay(10)
        applymovement(6, Common_Movement_WalkInPlaceFastDown)
        waitmovement(0)
        delay(15)
        msgbox(format("You vandals need to mind your own business! You've been spreading lies to my farmers and forcing them to abandon our practices. \pWhy do you think you know better than us?"))
        closemessage
        delay(15)
        applymovement(42, Common_Movement_WalkInPlaceFastUp)
        delay(15)
        msgbox(format("We've been trying to help you, your people, and the environment! All we want is what's best, and the way you've been working the land has not been sustainable."))
        closemessage
        delay(15)
        applymovement(6, Common_Movement_ExclamationMark)
        waitmovement(0)
        applymovement(6, Common_Movement_FacePlayer)
        applymovement(42, Common_Movement_FacePlayer)
        applymovement(7, Common_Movement_FacePlayer)
        waitmovement(0)
        msgbox(format("And you!\pYou just waltzed into my ranch with that Absol of yours and thought you could tell us what to do!\pI won't stand for it!"))
        closemessage
        delay(15)
        getplayerxy(VAR_TEMP_0, VAR_TEMP_1)
        if (var(VAR_TEMP_0) == 48 && var(VAR_TEMP_1) == 66){
            applymovement(6, Common_Movement_FacePlayer)
        }
        if (var(VAR_TEMP_0) == 48 && var(VAR_TEMP_1) == 67){
            applymovement(6, MainFarmerToRight)
            applymovement(7, MainFarmerToRight)
            waitmovement(0)
            applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceUp)
        }
        if (var(VAR_TEMP_0) == 47 && var(VAR_TEMP_1) == 68){
            applymovement(6, MainFarmerToBottom)
            waitmovement(0)
            applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceUp)
        }
        if (var(VAR_TEMP_0) == 46 && var(VAR_TEMP_1) == 67){
            applymovement(6, MainFarmerToLeft)
            applymovement(7, MainFarmerToLeft)
            waitmovement(0)
            applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceUp)
        }
        waitmovement(0)
        trainerbattle_single(TRAINER_GRUNT_WEATHER_INST_4, "I'll fight for my farm!", "You've forced my hand.", Ranch_EventScript_AfterFinalFarmerBattle)
    }
    if(var(VAR_RANCH_MORALITY_SYSTEM) < 10){
        applymovement(6, Common_Movement_FaceDown)
        waitmovement(0)
        delay(10)
        applymovement(6, Common_Movement_WalkInPlaceFastDown)
        waitmovement(0)
        delay(15)
        msgbox(format("Hah! Despite your best efforts, my farmers will continue with our ways. We know how to use our resources, and won't answer to vandals like you!"))
        closemessage
        delay(15)
        applymovement(42, Common_Movement_WalkInPlaceFastUp)
        delay(15)
        msgbox(format("We've just been trying to help you, your people, and the environment! All we want is what's best, and the way you've been working the land has not been sustainable. Your ranch will collapse!"))
        closemessage
        delay(15)
        applymovement(42, Common_Movement_ExclamationMark)
        waitmovement(0)
        applymovement(6, Common_Movement_FacePlayer)
        applymovement(42, Common_Movement_FacePlayer)
        applymovement(7, Common_Movement_FacePlayer)
        waitmovement(0)
        applymovement(6, Common_Movement_LockFacingDirection)
        waitmovement(0)
        msgbox(format("And you!\pWhy do you stand with technology? That Absol of yours should know that disaster lies ahead for this ranch!"))
        closemessage
        delay(15)
        getplayerxy(VAR_TEMP_0, VAR_TEMP_1)
        if (var(VAR_TEMP_0) == 48 && var(VAR_TEMP_1) == 66){
            applymovement(42, FinalProtestorToRight)
            waitmovement(0)
            applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceDown)
        }
        if (var(VAR_TEMP_0) == 48 && var(VAR_TEMP_1) == 67){
            applymovement(42, Common_Movement_FacePlayer)
        }
        if (var(VAR_TEMP_0) == 47 && var(VAR_TEMP_1) == 68){
            applymovement(42, Common_Movement_FacePlayer)
        }
        if (var(VAR_TEMP_0) == 46 && var(VAR_TEMP_1) == 67){
            applymovement(42, Common_Movement_FacePlayer)
        }
        waitmovement(0)
        trainerbattle_single(TRAINER_GRUNT_AQUA_HIDEOUT_5, "I'll fight for sustainability!", "Well, there's nothing else we can do.", Ranch_EventScript_AfterFinalProtestorBattle)
    }
}

movement MainFarmerToRight{
    walk_fast_right
    face_down
}

movement MainFarmerToBottom{
    walk_fast_right
    walk_fast_down*2
    face_left
}

movement MainFarmerToLeft{
    walk_fast_left
    face_down
}

movement FinalProtestorToRight{
    walk_fast_right
    face_up
}

script Ranch_EventScript_AfterFinalFarmerBattle{
    setflag(FLAG_RANCH_COMPLETE)
    applymovement(6, Common_Movement_FaceUp)
    waitmovement(0)
    delay(30)
    applymovement(6, ProtestorMadInPlaceUp)
    waitmovement(0)
    msgbox(format("You've left me with no choice."))
    closemessage
    delay(30)
    applymovement(6, Common_Movement_FacePlayer)
    waitmovement(0)
    delay(30)
    msgbox(format("We will try the methods you have introduced today. I must admit, we are obviously struggling. I hope your plan can get us out of this mess."))
    closemessage
    delay(30)
    playse(SE_PIN)
    waitse
    msgbox("Wait!")
    closemessage
    addobject(39)
    waitmovement(0)
	setobjectxyperm(39, 57, 67)
    waitmovement(0)
    delay(15)
    applymovement(6, Common_Movement_FaceRight)
    applymovement(7, Common_Movement_FaceRight)
    applymovement(42, Common_Movement_FaceRight)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceRight)
    applymovement(OBJ_EVENT_ID_FOLLOWER, Common_Movement_FaceRight)
    waitmovement(0)
    applymovement(6, Common_Movement_ExclamationMark)
    applymovement(7, Common_Movement_ExclamationMark)
    applymovement(42, Common_Movement_ExclamationMark)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_ExclamationMark)
    applymovement(OBJ_EVENT_ID_FOLLOWER, Common_Movement_ExclamationMark)
    waitmovement(0)
    applymovement(39, TechBroToScene)
    waitmovement(0)
    msgbox(format("What about our technology? I can bring back the water, and the crops, and the prosperity!\pTrust me and my science!"))
    closemessage
    delay(15)
    applymovement(42, Common_Movement_JumpInPlaceRight)
    playse(SE_BIKE_HOP)
    waitmovement(0)
    delay(15)
    msgbox(format("Your technology is unproven! It could lead to more destruction and pain!\pBesides, we already know what to do to live sustainably. We just have to do it!"))
    closemessage
    delay(30)
    applymovement(39, FarmerFreakOut)
    playse(SE_BIKE_HOP)
    waitmovement(0)
    applymovement(39, Common_Movement_FaceLeft)
    waitmovement(0)
    delay(15)
    msgbox(format("Unbelievable! You are doomed!"))
    closemessage
    delay(10)
    applymovement(39, TechBroFromScene)
    waitmovement(0)
    delay(120)
    fadenewbgm(MUS_DUMMY)
    fadescreenspeed(FADE_TO_BLACK, 8)
    delay(30)
    msgbox(format("One year later...$"))
    closemessage
    delay(120)
    warpcontinuescript(MAP_RANCH_GOOD_ENDING, 40, 28, GoodEnding_EventScript)
    end
}

movement TechBroToScene{
    walk_faster_up*2
    walk_faster_left*7
}

movement TechBroFromScene{
    walk_faster_right*7
    walk_faster_down*2
}

script Ranch_EventScript_AfterFinalProtestorBattle{
    setflag(FLAG_RANCH_COMPLETE)
    applymovement(42, Common_Movement_FaceDown)
    waitmovement(0)
    delay(30)
    applymovement(42, FarmerMadInPlaceDown)
    waitmovement(0)
    msgbox(format("You win."))
    closemessage
    delay(30)
    applymovement(42, Common_Movement_FacePlayer)
    waitmovement(0)
    delay(30)
    msgbox(format("We've tried everything. No matter what we do, you are unwilling to accept the truth.\pHave fun with your technology, I give up."))
    closemessage
    delay(30)
    playse(SE_PIN)
    waitse
    msgbox("Excellent choice!")
    closemessage
    addobject(39)
    waitmovement(0)
	setobjectxyperm(39, 57, 67)
    waitmovement(0)
    applymovement(6, Common_Movement_UnlockFacingDirection)
    waitmovement(0)
    delay(15)
    applymovement(6, Common_Movement_FaceRight)
    applymovement(7, Common_Movement_FaceRight)
    applymovement(42, Common_Movement_FaceRight)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceRight)
    applymovement(OBJ_EVENT_ID_FOLLOWER, Common_Movement_FaceRight)
    waitmovement(0)
    applymovement(6, Common_Movement_ExclamationMark)
    applymovement(7, Common_Movement_ExclamationMark)
    applymovement(42, Common_Movement_ExclamationMark)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_ExclamationMark)
    applymovement(OBJ_EVENT_ID_FOLLOWER, Common_Movement_ExclamationMark)
    waitmovement(0)
    applymovement(39, TechBroToScene)
    waitmovement(0)
    msgbox(format("I'm so glad you have seen the light! My scientific discoveries will make this ranch thrive once more!"))
    closemessage
    delay(15)
    applymovement(42, Common_Movement_JumpInPlaceRight)
    playse(SE_BIKE_HOP)
    waitmovement(0)
    delay(15)
    msgbox(format("You fool! Your technology is unproven! We know how to live sustainably, and we don't need you!"))
    closemessage
    delay(30)
    applymovement(39, Common_Movement_WalkInPlaceLeft)
    waitmovement(0)
    delay(15)
    msgbox(format("That's not how the farmers see it."))
    closemessage
    delay(10)
    applymovement(42, Common_Movement_JumpInPlaceRight)
    playse(SE_BIKE_HOP)
    waitmovement(0)
    delay(15)
    msgbox(format("I can't believe you all!"))
    closemessage
    applymovement(42, LastProtestorFromScene)
    waitmovement(0)
    delay(120)
    fadenewbgm(MUS_DUMMY)
    fadescreenspeed(FADE_TO_BLACK, 8)
    delay(30)
    msgbox(format("One year later...$"))
    closemessage
    delay(120)
    warpcontinuescript(MAP_RANCH_BAD_ENDING, 40, 28, BadEnding_EventScript)
    end
}

script GoodEnding_EventScript{
    lock
    hideobjectat(OBJ_EVENT_ID_PLAYER, MAP_RANCH_GOOD_ENDING)
    waitmovement(0)
    //playbgm(MUS_STARDEW_OVERTURE, FALSE)
    fadescreenspeed(FADE_FROM_BLACK, 8)
    waitmovement(0)
    special(SpawnCameraObject)
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_CAMERA, RightPan)
    waitmovement(0)
    fadescreen(FADE_TO_BLACK)
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_CAMERA, FirstOffScreenCam)
    //setvar(VAR_0x8004, 61)
    //setvar(VAR_0x8005, 44)
    //special(TeleportCamera)
    waitmovement(0)
    delay(15)
    fadescreen(FADE_FROM_BLACK)
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_CAMERA, LeftPan)
    waitmovement(0)
    fadescreen(FADE_TO_BLACK)
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_CAMERA, SecondOffScreenCam)
    //setvar(VAR_0x8004, 25)
    //setvar(VAR_0x8005, 63)
    //special(TeleportCamera)
    waitmovement(0)
    delay(15)
    fadescreen(FADE_FROM_BLACK)
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_CAMERA, CameraLastMovement)
    waitmovement(0)
    delay(30)
    applymovement(1, Common_Movement_WalkInPlaceDown)
    waitmovement(0)
    delay(15)
    msgbox(format("Thank you for joining me for our annual Harvest Festival.\pI'm sure you have all noticed our harvest is more abundant than last year, by far."))
    closemessage
    delay(15)
    applymovement(1, Common_Movement_WalkInPlaceLeft)
    waitmovement(15)
    msgbox(format("To the surprise of many of us, the sustainability initiatives have paid off!\pWho knew that the cacti surrounding us could provide us with both fruit and fresh water?"))
    closemessage
    delay(15)
    applymovement(1, Common_Movement_WalkInPlaceRight)
    waitmovement(0)
    msgbox(format("And we are already healthier after ditching those chemical pesticides and fertilizers."))
    closemessage
    delay(15)
    applymovement(1, Common_Movement_WalkInPlaceDown)
    waitmovement(0)
    msgbox(format("Our life is still difficult. We will struggle with droughts, and living in harsh conditions will not be easy.\pHowever, after taking the advice of those meddling protestors, we will be able to survive.\pEnough out of me, dig in!"))
    closemessage
    delay(15)
    playse(SE_APPLAUSE)
    applymovement(3, moves(jump_in_place_down*5))
    applymovement(5, moves(jump_in_place_down*5))
    applymovement(9, moves(jump_in_place_up*3))
    applymovement(10, EatUp)
    applymovement(8, EatUp)
    applymovement(6, EatUp)
    applymovement(7, EatUp)
    applymovement(2, EatDown)
    applymovement(4, EatDown)
    waitmovement(0)
    waitse
    fadescreenspeed(FADE_TO_BLACK,6)
    delay(30)
    fadeoutbgm(0)
    callnative(StartCredits)
    release
    end
}

movement RightPan{
    walk_right*20
}

movement LeftPan{
    walk_left*20
}

movement CameraLastMovement{
    walk_right*15
    walk_diag_southeast*8
}

movement FirstOffScreenCam{
    walk_diag_southeast
    walk_faster_down*15
}

movement SecondOffScreenCam{
    walk_diag_southwest*16
    walk_faster_down*3
}

movement EatUp{
    walk_in_place_fast_up*24
}

movement EatDown{
    walk_in_place_fast_down*24
}

script BadEnding_EventScript{
    lock
    hideobjectat(OBJ_EVENT_ID_PLAYER, MAP_RANCH_BAD_ENDING)
    waitmovement(0)
    //playbgm(MUS_STARDEW_CLOTH, FALSE)
    fadescreenspeed(FADE_FROM_BLACK, 8)
    waitmovement(0)
    special(SpawnCameraObject)
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_CAMERA, RightPan)
    waitmovement(0)
    fadescreen(FADE_TO_BLACK)
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_CAMERA, FirstOffScreenCam)
    //setvar(VAR_0x8004, 61)
    //setvar(VAR_0x8005, 44)
    //special(TeleportCamera)
    waitmovement(0)
    delay(15)
    fadescreen(FADE_FROM_BLACK)
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_CAMERA, LeftPan)
    waitmovement(0)
    fadescreen(FADE_TO_BLACK)
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_CAMERA, SecondOffScreenCam)
    //setvar(VAR_0x8004, 25)
    //setvar(VAR_0x8005, 63)
    //special(TeleportCamera)
    waitmovement(0)
    delay(15)
    fadescreen(FADE_FROM_BLACK)
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_CAMERA, CameraLastMovement)
    waitmovement(0)
    delay(30)
    applymovement(1, Common_Movement_WalkInPlaceDown)
    waitmovement(0)
    delay(15)
    msgbox(format("Well, thank you, both of you. \pNot only for attending the annual Harvest Festival, but also for staying on the farm this past year.\pI know it's been difficult, given the people we've lost and the fact that the water did not come back."))
    closemessage
    delay(15)
    applymovement(2, Common_Movement_WalkInPlaceUp)
    waitmovement(15)
    msgbox(format("About that, boss...\pWe've decided to leave too."))
    closemessage
    delay(15)
    applymovement(1, Common_Movement_ExclamationMark)
    waitmovement(0)
    delay(15)
    applymovement(1, Common_Movement_WalkInPlaceDown)
    waitmovement(0)
    playse(SE_PIN)
    waitse
    delay(15)
    msgbox(format("What?!"))
    closemessage
    delay(45)
    applymovement(3, Common_Movement_WalkInPlaceUp)
    waitmovement(0)
    delay(15)
    msgbox(format("That's right. There just isn't anything left for us. We need to move on to greener pastures."))
    closemessage
    delay(30)
    applymovement(1, Common_Movement_WalkInPlaceLeft)
    waitmovement(0)
    delay(30)
    msgbox(format("I understand. We were all let down by those promises, huh?"))
    closemessage
    delay(15)
    playse(SE_PIN)
    waitse
    msgbox(format("No need to worry! I'm back!"))
    closemessage
    applymovement(1, Common_Movement_FaceRight)
    applymovement(2, Common_Movement_FaceRight)
    applymovement(3, Common_Movement_FaceRight)
    waitmovement(0)
    applymovement(1, Common_Movement_ExclamationMark)
    applymovement(2, Common_Movement_ExclamationMark)
    applymovement(3, Common_Movement_ExclamationMark)
    waitmovement(0)
    applymovement(4, moves(walk_left*3))
    waitmovement(0)
    msgbox(format("My scientists have come up with all sorts of new solutions!\pI understand that these new wells didn't bring forth any water, but that's why we have planned a pipeline to bring in ocean water!\pIt'll take a lot of energy, but we can take out the salt, converting it to freshwater!\pDoesn't that sound grand?"))
    closemessage
    delay(15)
    applymovement(3, Common_Movement_WalkInPlaceLeft)
    waitmovement(0)
    delay(30)
    applymovement(3, Common_Movement_WalkInPlaceRight)
    applymovement(1, Common_Movement_FaceDown)
    waitmovement(0)
    delay(15)
    msgbox(format("We're not interested. Your technological solutions didn't work last year, and we have no faith in them working this year."))
    closemessage
    applymovement(3, moves(walk_fast_right*10))
    applymovement(2, moves(walk_fast_right*10))
    waitmovement(0)
    applymovement(1, Common_Movement_FaceRight)
    waitmovement(0)
    delay(15)
    playse(SE_EXIT)
    waitse
    delay(30)
    applymovement(4, Common_Movement_WalkInPlaceLeft)
    waitmovement(0)
    delay(15)
    msgbox(format("Well? What do you think?"))
    closemessage
    delay(15)
    applymovement(1, Common_Movement_WalkInPlaceRight)
    waitmovement(0)
    delay(15)
    msgbox(format("I'm out too. We should've listened to those kids."))
    closemessage
    applymovement(1, moves(walk_fast_right*4))
    waitmovement(0)
    applymovement(1, moves(walk_fast_right*2))
    waitmovement(0)
    applymovement(4, Common_Movement_FaceUp)
    applymovement(1, moves(walk_fast_right*4))
    waitmovement(0)
    applymovement(4, Common_Movement_FaceRight)
    waitmovement(0)
    playse(SE_EXIT)
    waitse
    delay(15)
    applymovement(4, FarmerFreakOut)
    playse(SE_BIKE_HOP)
    waitmovement(0)
    applymovement(4, Common_Movement_FaceRight)
    waitmovement(0)
    msgbox(format("Wait!"))
    closemessage
    applymovement(4, moves(walk_faster_right*4))
    waitmovement(0)
    fadescreenspeed(FADE_TO_BLACK,6)
    delay(30)
    fadeoutbgm(0)
    callnative(StartCredits)
    release
    end
}

script Ranch_EventScript_TrampleBattle {
	trainerbattle_single(TRAINER_GRUNT_AQUA_HIDEOUT_6, Jerry_Intro, Jerry_Outro)
	msgbox(PostBattle_Jerry, MSGBOX_AUTOCLOSE) 
	waitmessage
    end
}
text Jerry_Intro{
    format("Hey kid! Quit trampling my crops!")
}
text Jerry_Outro{
    format("Watch your step, why don't ya?")
}
text PostBattle_Jerry{
    format("I've been doin' everything I can to grow this hay.\pIt's been real tough this year.")
}

script Ranch_EventScript_BugBattle {
