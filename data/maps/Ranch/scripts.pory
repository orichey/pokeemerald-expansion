script Ranch_EventScript_HayFarmer{
	lock
	faceplayer
	msgbox(format("I'm taking stock of our hay supply. Looks like we'll have just enough for this year, but not enough for next."))
	closemessage
	applymovement(31, Common_Movement_FaceOriginalDirection)
	waitmovement(0)
	release
	end
}

script Ranch_EventScript_OldMan{
	lock
	faceplayer
	msgbox(format("When I was a boy, this area was on the same level as the rest of the ranch.\pHowever, due to the use of this well, the land has sunk!\pThe power of technology is amazing!"))
	closemessage
	applymovement(14, Common_Movement_FaceOriginalDirection)
	waitmovement(0)
	release
	end
}

script Ranch_Text_BarnSign{
    lock
    msgbox(format("Free-Range Lechonk and Torchic raised here!"))
    release
}

script Ranch_EventScript_Boy{
	lock
	faceplayer
	msgbox(format("I've never seen water in this riverbed.\pMy parents tell me it used to run full every year. I guess we used up all the water!"))
	closemessage
	applymovement(48, Common_Movement_FaceOriginalDirection)
	waitmovement(0)
	release
	end
}

script Ranch_EventScript_TruckMan{
	lock
	faceplayer
	msgbox(format("Trucks have delivered us water to grow our crops. This can't be a sustainable practice, but it's gotten us through a few rough years."))
	closemessage
	applymovement(49, Common_Movement_FaceOriginalDirection)
	waitmovement(0)
	release
	end
}