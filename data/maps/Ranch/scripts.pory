script Ranch_EventScript_SeventhFarmerLeave{
    lock
    delay(15)
    applymovement(27, Common_Movement_FaceAwayPlayer)
    waitmovement(0)
    delay(15)
    msgbox(format("Without fertilizers, we will see widespread famine."))
    closemessage
    delay(15)
    applymovement(27, Common_Movement_FacePlayer)
    delay(15)
    msgbox(format("This ranch will fail."))
    closemessage
    delay(15)
    fadescreenswapbuffers(FADE_TO_BLACK)
    removeobject(27)
    playse(SE_EXIT)
    waitse
    setflag(FLAG_PROTEST_WIN_7)
    setflag(FLAG_FARMER7_BATTLE)
    if(flag(FLAG_FARMER1_BATTLE) == TRUE && flag(FLAG_FARMER2_BATTLE) == TRUE && flag(FLAG_FARMER3_BATTLE) == TRUE && flag(FLAG_FARMER4_BATTLE) == TRUE && flag(FLAG_FARMER5_BATTLE) == TRUE && flag(FLAG_FARMER6_BATTLE) == TRUE && flag(FLAG_FARMER7_BATTLE) == TRUE){
        setflag(FLAG_READY_FINAL_RANCH_BATTLE)
        setvar(VAR_RANCH_STATE, 2)
    }
    addvar(VAR_RANCH_MORALITY_SYSTEM, 1)
    applymovement(28, Common_Movement_UnlockFacingDirection)
    waitmovement(0)
    SetObjectMovementType(28, MOVEMENT_TYPE_WANDER_AROUND)
    waitmovement(0)
    setobjectxyperm(28, 27, 48)
    addobject(28)
    waitmovement(0)
    delay(15)
    fadescreenswapbuffers(FADE_FROM_BLACK)
    goto(Ranch_EventScript_ProtestWin7)
    release
    end
}

script Ranch_EventScript_SeventhProtestorLeave{
    lock
    delay(15)
    applymovement(28, Common_Movement_FaceAwayPlayer)
    waitmovement(0)
    delay(15)
    msgbox(format("Chemicals on our food should be cause for concern."))
