script Ranch_EventScript_FirstFarmerLeave{
    lock
    delay(15)
    applymovement(30, Common_Movement_FaceAwayPlayer)
    waitmovement(0)
    delay(15)
    msgbox(format("...\pWithout our animals, we will starve."))
    closemessage
    delay(15)
    applymovement(30, FarmerFreakOut)
    playse(SE_BIKE_HOP)
    waitmovement(0)
    applymovement(30, Common_Movement_FacePlayer)
    delay(15)
    msgbox(format("This is all your fault!"))
    closemessage
    delay(15)
    fadescreenswapbuffers(FADE_TO_BLACK)
    removeobject(30)
    playse(SE_EXIT)
    waitse
    setflag(FLAG_PROTEST_WIN_1)
    setflag(FLAG_FARMER1_BATTLE)
    if(flag(FLAG_FARMER1_BATTLE) == TRUE && flag(FLAG_FARMER2_BATTLE) == TRUE && flag(FLAG_FARMER3_BATTLE) == TRUE && flag(FLAG_FARMER4_BATTLE) == TRUE && flag(FLAG_FARMER5_BATTLE) == TRUE && flag(FLAG_FARMER6_BATTLE) == TRUE && flag(FLAG_FARMER7_BATTLE) == TRUE){
        setflag(FLAG_READY_FINAL_RANCH_BATTLE)
        setvar(VAR_RANCH_STATE, 2)
    }
    addvar(VAR_RANCH_MORALITY_SYSTEM, 1)
    applymovement(29, Common_Movement_UnlockFacingDirection)
    waitmovement(0)
    SetObjectMovementType(29, MOVEMENT_TYPE_WANDER_AROUND)
    waitmovement(0)
    setobjectxyperm(29, 18, 66)
    addobject(29)
    waitmovement(0)
    delay(15)
    removeobject(2)
    removeobject(3)
    waitmovement(0)
    fadescreenswapbuffers(FADE_FROM_BLACK)
    goto(Ranch_EventScript_ProtestWin1)
    release
    end
}

script Ranch_EventScript_FirstProtesterLeave{
    lock
    delay(15)
    applymovement(29, Common_Movement_FaceAwayPlayer)
    waitmovement(0)
    delay(15)
    msgbox(format("...\pThese animals will continue to suffer, and water will continue to be wasted."))
    closemessage
    delay(15)
    applymovement(29, FarmerFreakOut)
    playse(SE_BIKE_HOP)
    waitmovement(0)
    applymovement(29, Common_Movement_FacePlayer)
    delay(15)
    msgbox(format("This is all your fault!"))
    closemessage
    delay(15)
    fadescreenswapbuffers(FADE_TO_BLACK)
    removeobject(29)
    playse(SE_EXIT)
    waitse
    setflag(FLAG_FARMER_WIN_1)
    setflag(FLAG_FARMER1_BATTLE)
    if(flag(FLAG_FARMER1_BATTLE) == TRUE && flag(FLAG_FARMER2_BATTLE) == TRUE && flag(FLAG_FARMER3_BATTLE) == TRUE && flag(FLAG_FARMER4_BATTLE) == TRUE && flag(FLAG_FARMER5_BATTLE) == TRUE && flag(FLAG_FARMER6_BATTLE) == TRUE && flag(FLAG_FARMER7_BATTLE) == TRUE){
        setflag(FLAG_READY_FINAL_RANCH_BATTLE)
        setvar(VAR_RANCH_STATE, 2)
    }
    subvar(VAR_RANCH_MORALITY_SYSTEM, 1)
    applymovement(30, Common_Movement_UnlockFacingDirection)
    waitmovement(0)
    SetObjectMovementType(30, MOVEMENT_TYPE_WANDER_AROUND)
    waitmovement(0)
    setobjectxyperm(30, 19, 66)
    addobject(30)
    waitmovement(0)
    delay(15)
    fadescreenswapbuffers(FADE_FROM_BLACK)
    goto(Ranch_EventScript_FarmerWin1)
    release
    end
}

movement FarmerFreakOut{
    jump_in_place_left
    walk_in_place_fast_down
    walk_in_place_fast_right
    walk_in_place_fast_up
    walk_in_place_fast_left*3
    walk_in_place_fast_right
}

movement FarmerToLeft{
    walk_fast_up
    walk_fast_left*2
    face_down
}

movement FarmerToTopLeft{
    walk_fast_up
    face_left
}

movement FarmerToBottomLeft{
    walk_fast_down
    face_left
}

movement ProtestorToTopRight{
    walk_fast_up
    face_right
}

movement ProtestorToBottomRight{
    walk_fast_down
    face_right
}

movement ProtestorToRight{
    walk_fast_up
    walk_fast_right*2
    face_down
}

script Ranch_EventScript_BlockingFarmer1{
    lock
    faceplayer
	msgbox(format("It's been months since it last rained. I'm not sure how much longer we can last."))
	closemessage
	applymovement(32, Common_Movement_FaceOriginalDirection)
	waitmovement(0)
	release
	end
}

script Ranch_EventScript_BlockingFarmer2{
    lock
    faceplayer
	msgbox(format("We've been trucking in water for our last crop of hay. We can't afford to buy more for next year."))
	closemessage
	applymovement(33, Common_Movement_FaceOriginalDirection)
	waitmovement(0)
	release
	end
}

script Ranch_EventScript_WellEncounterFarmer{
    if(flag(FLAG_FARMER2_BATTLE) == FALSE){
        lock
        applymovement(35, Common_Movement_WalkInPlaceFastLeft)
        waitmovement(0)
        delay(15)
        msgbox(format("Your practices are sucking this ranch dry. You're already running out of water, you can't just keep drilling for more!"))
        closemessage
        delay(15)
        applymovement(34, Common_Movement_WalkInPlaceFastRight)
        delay(15)
        msgbox(format("This well has sustained us for as long as I've been here. I know there's more water down there, we just have to get it!"))
        closemessage
        delay(15)
        applymovement(35, Common_Movement_WalkInPlaceFastLeft)
        waitmovement(0)
        delay(15)
        msgbox(format("Water is pumped out thousands of times faster than it replenishes. Eventually you'll run out!\pWhat then?"))
        closemessage
        delay(15)
        applymovement(34, Common_Movement_WalkInPlaceFastRight)
        delay(15)
        msgbox(format("That's a problem for the future! For now, we need this water."))
        closemessage
        delay(15)
        faceplayer
        msgbox(format("How do you see it? Should we shut down the well, or drill deeper?"))
        dynmultichoice(0, 0, TRUE, 2, 0, DYN_MULTICHOICE_CB_NONE, "Stop the well!", "Keep drilling!")
        if (var(VAR_RESULT) == 0){
            applymovement(35, Common_Movement_LockFacingDirection)
            waitmovement(0)
            applymovement(34, FarmerMadInPlaceRight)
            waitmovement(0)
            delay(15)
            msgbox(format("How do you suppose we water our crops without our well?"))
            closemessage
            getplayerxy(VAR_TEMP_0, VAR_TEMP_1)
            if (var(VAR_TEMP_0) == 55 && var(VAR_TEMP_1) == 59){
                applymovement(34, Common_Movement_FacePlayer)
            }
            if (var(VAR_TEMP_0) == 56 && var(VAR_TEMP_1) == 60){
                applymovement(34, Common_Movement_FacePlayer)
            }
            if (var(VAR_TEMP_0) == 57 && var(VAR_TEMP_1) == 60){
                applymovement(34, Farmer2ToRight)
                waitmovement(0)
                applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceLeft)
            }
            waitmovement(0)
            trainerbattle_single(TRAINER_GRUNT_SEAFLOOR_CAVERN_4, "We will keep using this well!", "Do you want us to starve?", Ranch_EventScript_SecondFarmerLeave)
        }
        if (var(VAR_RESULT) == 1){
            applymovement(34, Common_Movement_LockFacingDirection)
            waitmovement(0)
            applymovement(35, ProtestorMadInPlaceLeft)
            waitmovement(0)
            delay(15)
            msgbox(format("I'm trying to help you! You will draw all of the groundwater out of the earth!"))
            closemessage
            getplayerxy(VAR_TEMP_0, VAR_TEMP_1)
            if (var(VAR_TEMP_0) == 55 && var(VAR_TEMP_1) == 59){
                applymovement(35, Protestor2ToLeft)
                waitmovement(0)
                applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceDown)
            }
            if (var(VAR_TEMP_0) == 56 && var(VAR_TEMP_1) == 60){
                applymovement(35, Protestor2Down)
                waitmovement(0)
                applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceRight)
            }
            if (var(VAR_TEMP_0) == 57 && var(VAR_TEMP_1) == 60){
                applymovement(35, Common_Movement_FacePlayer)
            }
            waitmovement(0)
            trainerbattle_single(TRAINER_DECLAN, "Why do you support this?", "Did you listen to me?", Ranch_EventScript_SecondProtestorLeave)
        }
    }
    if(flag(FLAG_FARMER2_BATTLE) == TRUE){
        lock
        faceplayer
        waitmovement(0)
        msgbox(format("Thanks for the hand. I know the well is running low, but we'll just drill deeper and get more water."))
        closemessage
    }
    release
    end
}

