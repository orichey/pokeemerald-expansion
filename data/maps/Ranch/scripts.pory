    waitse
    setflag(FLAG_FARMER_WIN_7)
    setflag(FLAG_FARMER7_BATTLE)
    if(flag(FLAG_FARMER1_BATTLE) == TRUE && flag(FLAG_FARMER2_BATTLE) == TRUE && flag(FLAG_FARMER3_BATTLE) == TRUE && flag(FLAG_FARMER4_BATTLE) == TRUE && flag(FLAG_FARMER5_BATTLE) == TRUE && flag(FLAG_FARMER6_BATTLE) == TRUE && flag(FLAG_FARMER7_BATTLE) == TRUE){
        setflag(FLAG_READY_FINAL_RANCH_BATTLE)
        setvar(VAR_RANCH_STATE, 2)
    }
    subvar(VAR_RANCH_MORALITY_SYSTEM, 1)
    applymovement(27, Common_Movement_UnlockFacingDirection)
