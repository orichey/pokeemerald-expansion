script Ranch_EventScript_FifthFarmerLeave{
    lock
    delay(15)
    applymovement(40, Common_Movement_FaceAwayPlayer)
    waitmovement(0)
    delay(15)
    msgbox(format("The only thing us farmers know is hay. Asking us to grow anything else is like asking us to learn a new language."))
    closemessage
    delay(15)
    applymovement(40, Common_Movement_FacePlayer)
    delay(15)
    msgbox(format("It just won't happen."))
    closemessage
    delay(15)
    fadescreenswapbuffers(FADE_TO_BLACK)
    removeobject(40)
    playse(SE_EXIT)
    waitse
    setflag(FLAG_PROTEST_WIN_5)
    setflag(FLAG_FARMER5_BATTLE)
    if(flag(FLAG_FARMER1_BATTLE) == TRUE && flag(FLAG_FARMER2_BATTLE) == TRUE && flag(FLAG_FARMER3_BATTLE) == TRUE && flag(FLAG_FARMER4_BATTLE) == TRUE && flag(FLAG_FARMER5_BATTLE) == TRUE && flag(FLAG_FARMER6_BATTLE) == TRUE && flag(FLAG_FARMER7_BATTLE) == TRUE){
        setflag(FLAG_READY_FINAL_RANCH_BATTLE)
        setvar(VAR_RANCH_STATE, 2)
    }
    addvar(VAR_RANCH_MORALITY_SYSTEM, 1)
    applymovement(41, Common_Movement_UnlockFacingDirection)
    waitmovement(0)
    SetObjectMovementType(41, MOVEMENT_TYPE_WANDER_AROUND)
    waitmovement(0)
    setobjectxyperm(41, 67, 31)
    addobject(41)
    waitmovement(0)
    delay(15)
    fadescreenswapbuffers(FADE_FROM_BLACK)
    goto(Ranch_EventScript_ProtestWin5)
    release
    end
}

