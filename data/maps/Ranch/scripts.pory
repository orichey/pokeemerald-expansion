script Ranch_EventScript_FarmerBattle {
	lock
    if(flag(FLAG_FARMER1_BATTLE) != TRUE || flag(FLAG_FARMER2_BATTLE) != TRUE || flag(FLAG_FARMER3_BATTLE) != TRUE || flag(FLAG_FARMER4_BATTLE) != TRUE || flag(FLAG_FARMER5_BATTLE) != TRUE || flag(FLAG_FARMER6_BATTLE) != TRUE || flag(FLAG_FARMER7_BATTLE) != TRUE){
        faceplayer
        msgbox(format("This kind gentleman spoke to my farmers about his technology.\pSounds like they're being harrassed by these protestors. Could you help them out?"))
        if(flag(FLAG_FARMER1_BATTLE) == FALSE){
            msgbox(format("I saw one of those kids in orange head west. Maybe check the barns?"))
            closemessage
            releaseall
            end
        }
        if(flag(FLAG_FARMER2_BATTLE) == FALSE){
            msgbox(format("One of my farmers is having an issue by the well."))
            closemessage
            releaseall
            end
        }
        if(flag(FLAG_FARMER3_BATTLE) == FALSE || flag(FLAG_FARMER4_BATTLE) == FALSE){
            msgbox(format("I heard something happening in the fields. Can you take a look?"))
            closemessage
            releaseall
            end
        }
        if(flag(FLAG_FARMER5_BATTLE) == FALSE){
            msgbox(format("I think I saw a protestor head to the northeast, near where we used to farm."))
            closemessage
            releaseall
            end
        }
        if(flag(FLAG_FARMER6_BATTLE) == FALSE || flag(FLAG_FARMER7_BATTLE) == FALSE){
            msgbox(format("A few scientist were heading to the riverbed. Maybe something is happening there?"))
            closemessage
            releaseall
            end
        }
    }
    if(flag(FLAG_FARMER1_BATTLE) == TRUE && flag(FLAG_FARMER2_BATTLE) == TRUE && flag(FLAG_FARMER3_BATTLE) == TRUE && flag(FLAG_FARMER4_BATTLE) == TRUE && flag(FLAG_FARMER5_BATTLE) == TRUE && flag(FLAG_FARMER6_BATTLE) == TRUE && flag(FLAG_FARMER7_BATTLE) == TRUE){
        goto(Ranch_EventScript_FinalEncounter)
        releaseall
        end
    }
    releaseall
    end
}


movement GentlemanToScene{
    walk_left*4
}

movement CameraToGentleman{
    walk_diag_southeast
    walk_right*4
}

movement ConfrontGentleman1{
    walk_fast_up*5
}

movement ConfrontGentleman2{
    walk_fast_up*6
    face_left
}

movement ToAbsolTop{
    walk_left
    walk_diag_northwest
}

movement FromAbsolTop{
    walk_diag_southeast
    walk_right
}

movement ToPlayerTop{
    walk_left*2
    walk_diag_northwest
}

movement ToAbsolMiddle{
    walk_left*2
}

movement FromAbsolMiddle{
    walk_right*2
}

movement ToPlayerMiddle{
    walk_left*3
}

movement ToAbsolBottom{
    walk_diag_southwest
    walk_left
}

movement FromAbsolBottom{
    walk_diag_northeast
    walk_right
}

movement ToPlayerBottom{
    walk_diag_southwest
    walk_left*2
}

movement CameraToFarmerFirst{
    walk_left*2
}

movement CameraToFarmerFirstMiddle{
    walk_diag_northwest
    walk_left
}

movement CameraToFarmerFirstBottom{
    walk_diag_northwest*2
}

script Ranch_EventScript_Man1{
	lock
	faceplayer
    if(flag(FLAG_FARMER_SPEECH) == FALSE){
	    msgbox(format("I was excited for our annual feast.\nHowever, I should not have expected much, after this past year."))
    }
    if(flag(FLAG_FARMER_SPEECH) == TRUE){
        msgbox(format("I sure hope we have a better feast next year..."))
    }
	closemessage
	applymovement(12, Common_Movement_FaceOriginalDirection)
	waitmovement(0)
	release
	end
}

