    }
    if(flag(FLAG_FARMER_SPEECH) == TRUE){
        msgbox(format("I'm not changing my ways like those children dressed in orange want.\pI like what that other gentleman was suggesting, though."))
    }
	closemessage
	applymovement(15, Common_Movement_FaceOriginalDirection)
	waitmovement(0)
	release
	end
}

