    waitmovement(0)
    delay(15)
    fadescreenswapbuffers(FADE_FROM_BLACK)
    goto(Ranch_EventScript_FarmerWin4)
    release
    end
}

movement Farmer4ToLeft{
    walk_fast_left
    face_down
}

movement Farmer4ToBottom{
    walk_fast_left
    walk_fast_down*2
    face_right
}

movement Protestor4ToLeft{
    walk_fast_left
    face_up
}

movement Protestor4ToTop{
    walk_fast_left
    walk_fast_up*2
    face_right
}

script Ranch_EventScript_SoilDepletionEncounterFarmer{
    if(flag(FLAG_FARMER5_BATTLE) == FALSE){
        lock
        applymovement(41, Common_Movement_WalkInPlaceFastRight)
        waitmovement(0)
        delay(15)
        msgbox(format("Don't you wonder why this area has become a desert? Repeatedly growing hay has depleted the soil of all the nutrients!"))
        closemessage
        delay(15)
        applymovement(40, Common_Movement_WalkInPlaceFastLeft)
        delay(15)
        msgbox(format("What are we supposed to do about that? We have to grow something!"))
        closemessage
        delay(15)
        applymovement(41, Common_Movement_WalkInPlaceFastRight)
        waitmovement(0)
        delay(15)
        msgbox(format("Some plants can add nutrients to the soil, and if you have a diverse selection of crops, you'll have healthier soil.\pIt won't all blow away in the wind, too."))
        closemessage
        delay(15)
        applymovement(40, Common_Movement_WalkInPlaceFastLeft)
        delay(15)
        msgbox(format("Don't lecture me! Why do you think you know more about soil health than I do?"))
        closemessage
        delay(15)
        faceplayer
        msgbox(format("We need to grow something! Should we diversify, or keep growing hay?"))
        dynmultichoice(0, 0, TRUE, 2, 0, DYN_MULTICHOICE_CB_NONE, "Diversify!", "Hay!")
        if (var(VAR_RESULT) == 0){
            applymovement(41, Common_Movement_LockFacingDirection)
            waitmovement(0)
            applymovement(40, FarmerFreakOut)
            waitmovement(0)
            applymovement(40, Common_Movement_FaceLeft)
            waitmovement(0)
            delay(15)
            msgbox(format("What would we even diversify with? All I've ever grown is hay!"))
            closemessage
            getplayerxy(VAR_TEMP_0, VAR_TEMP_1)
            if (var(VAR_TEMP_0) == 69 && var(VAR_TEMP_1) == 31){
                applymovement(40, Common_Movement_FacePlayer)
            }
            if (var(VAR_TEMP_0) == 68 && var(VAR_TEMP_1) == 30){
                applymovement(40, Common_Movement_FacePlayer)
            }
            if (var(VAR_TEMP_0) == 67 && var(VAR_TEMP_1) == 30){
                applymovement(40, Farmer5ToTop)
                waitmovement(0)
                applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceRight)
            }
            if (var(VAR_TEMP_0) == 66 && var(VAR_TEMP_1) == 31){
                applymovement(40, Farmer5ToLeft)
                waitmovement(0)
                applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceUp)
            }
            waitmovement(0)
            trainerbattle_single(TRAINER_GRUNT_MUSEUM_1, "I can't grow anything else!", "How am I supposed to learn anything\nelse?", Ranch_EventScript_FifthFarmerLeave)
        }
        if (var(VAR_RESULT) == 1){
            applymovement(40, Common_Movement_LockFacingDirection)
            waitmovement(0)
            applymovement(41, FarmerFreakOut)
            waitmovement(0)
            delay(15)
            msgbox(format("This soil is already unusable, the rest of your farmland will soon be desert too!"))
            closemessage
            getplayerxy(VAR_TEMP_0, VAR_TEMP_1)
            if (var(VAR_TEMP_0) == 66 && var(VAR_TEMP_1) == 31){
                applymovement(41, Common_Movement_FacePlayer)
            }
            if (var(VAR_TEMP_0) == 67 && var(VAR_TEMP_1) == 30){
                applymovement(41, Common_Movement_FacePlayer)
            }
            if (var(VAR_TEMP_0) == 68 && var(VAR_TEMP_1) == 30){
                applymovement(41, Protestor5ToTop)
                waitmovement(0)
                applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceLeft)
            }
            if (var(VAR_TEMP_0) == 69 && var(VAR_TEMP_1) == 31){
                applymovement(41, Protestor5ToRight)
                waitmovement(0)
                applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceUp)
            }
            waitmovement(0)
            trainerbattle_single(TRAINER_GRUNT_MUSEUM_2, "We need to grow other crops!", "Everything is going to get so much \nworse.", Ranch_EventScript_FifthProtestorLeave)
        }
    }
    if(flag(FLAG_FARMER5_BATTLE) == TRUE){
        lock
        faceplayer
        waitmovement(0)
        msgbox(format("Thanks for not forcing us to change our ways."))
        closemessage
    }
    release
    end
}

