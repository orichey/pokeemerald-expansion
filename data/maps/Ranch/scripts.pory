script Ranch_EventScript_Nurse{
    lock
    faceplayer
    if(flag(FLAG_RANCH_NURSE) == TRUE){
        msgbox(format("Would you like me to heal your Pokémon?"), MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES){
            special(HealPlayerParty)
            playfanfare(MUS_HEAL)
            waitfanfare
            msgbox(format("Let me know if you need my services again."))
            waitmessage
        }
        else{
            msgbox(format("Let me know if you need my services."))
        }
    }
    if(flag(FLAG_RANCH_NURSE) == FALSE){
        msgbox(format("Sigh... I was appointed to this post at the ranch. \pI miss my PokéCenter, the farmers are... smelly. \pAnyway...\pWould you like me to heal your Pokémon?"), MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES){
            special(HealPlayerParty)
            playfanfare(MUS_HEAL)
            waitfanfare
            msgbox(format("Let me know if you need my services again."))
            waitmessage
            setflag(FLAG_RANCH_NURSE)
        }
        else{
            msgbox(format("Let me know if you need my services."))
            waitmessage
            setflag(FLAG_RANCH_NURSE)
        }
    }
    applymovement(13, Common_Movement_FaceOriginalDirection)
    waitmovement(0)
    callnative(UpdateFollowingPokemon)
    release
    end
}

script Ranch_EventScript_Gentleman{
	lock
    faceplayer
	msgbox(format("I spoke with the farmers, and they are enthused by my proposal. \pMy technology will bring water back to this land, and they can continue to farm as they have for generations!"))
	closemessage
	applymovement(39, Common_Movement_FaceOriginalDirection)
	waitmovement(0)
	release
	end
}

script Ranch_EventScript_LiberateBattleProtestor{
    if(flag(FLAG_FARMER1_BATTLE) == FALSE){
        lock
        applymovement(30, Common_Movement_WalkInPlaceFastLeft)
        waitmovement(0)
        delay(15)
        msgbox(format("I don't care what your reason is! You can't just go around stealing my chickens!"))
        closemessage
        delay(15)
        applymovement(29, Common_Movement_WalkInPlaceFastRight)
        delay(15)
        msgbox(format("Those are sentient beings who are crammed in a barn all day! They deserve to be free!"))
        closemessage
        delay(15)
        applymovement(30, Common_Movement_WalkInPlaceFastLeft)
        waitmovement(0)
        delay(15)
        msgbox(format("We can't free them, that's crazy! If we did, what would we eat?"))
        closemessage
        delay(15)
        applymovement(29, Common_Movement_WalkInPlaceFastRight)
        delay(15)
        msgbox(format("You could grow different crops! You aren't eating that hay, you would save so much water if you grew plants that you could eat, instead of wasting it on animal farming."))
        closemessage
        delay(15)
        faceplayer
        msgbox(format("What do you think? Should we liberate the animals, or continue to eat them?"))
        dynmultichoice(0, 0, TRUE, 2, 0, DYN_MULTICHOICE_CB_NONE, "Liberate!", "Eat!")
        if (var(VAR_RESULT) == 0){
            applymovement(29, Common_Movement_LockFacingDirection)
            waitmovement(0)
            applymovement(30, FarmerFreakOut)
            playse(SE_BIKE_HOP)
            waitmovement(0)
            delay(15)
            msgbox(format("Dadgummit! I can't believe you agree with this city slicker!\pThis will end our lifestyle as we know it!"))
            closemessage
            getplayerxy(VAR_TEMP_0, VAR_TEMP_1)
            if (var(VAR_TEMP_0) == 17 && var(VAR_TEMP_1) == 66){
                applymovement(30, FarmerToLeft)
                waitmovement(0)
                applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceUp)
            }
            if (var(VAR_TEMP_0) == 18 && var(VAR_TEMP_1) == 65){
                applymovement(30, FarmerToTopLeft)
                waitmovement(0)
                applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceRight)
            }
            if (var(VAR_TEMP_0) == 18 && var(VAR_TEMP_1) == 67){
                applymovement(30, FarmerToBottomLeft)
                waitmovement(0)
                applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceRight)
            }
            if (var(VAR_TEMP_0) == 19 && var(VAR_TEMP_1) == 65){
                applymovement(30, Common_Movement_FacePlayer)
            }
            if (var(VAR_TEMP_0) == 20 && var(VAR_TEMP_1) == 66){
                applymovement(30, Common_Movement_FacePlayer)
            }
            if (var(VAR_TEMP_0) == 19 && var(VAR_TEMP_1) == 67){
                applymovement(30, Common_Movement_FacePlayer)
            }
            waitmovement(0)
            applymovement(29, Common_Movement_FaceRight)
            waitmovement(0)
            trainerbattle_single(TRAINER_ALBERTO, "I won't let you do this!", "Gah! How could you?", Ranch_EventScript_FirstFarmerLeave)
        }
        if (var(VAR_RESULT) == 1){
            applymovement(30, Common_Movement_LockFacingDirection)
            waitmovement(0)
            applymovement(29, FarmerFreakOut)
            playse(SE_BIKE_HOP)
            waitmovement(0)
            delay(15)
            msgbox(format("Are you crazy? How can you let this atrocity continue?"))
            closemessage
            getplayerxy(VAR_TEMP_0, VAR_TEMP_1)
            if (var(VAR_TEMP_0) == 17 && var(VAR_TEMP_1) == 66){
                applymovement(29, Common_Movement_FacePlayer)
            }
            if (var(VAR_TEMP_0) == 18 && var(VAR_TEMP_1) == 65){
                applymovement(29, Common_Movement_FacePlayer)
            }
            if (var(VAR_TEMP_0) == 18 && var(VAR_TEMP_1) == 67){
                applymovement(29, Common_Movement_FacePlayer)
            }
            if (var(VAR_TEMP_0) == 19 && var(VAR_TEMP_1) == 65){
                applymovement(29, ProtestorToTopRight)
                waitmovement(0)
                applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceLeft)
            }
            if (var(VAR_TEMP_0) == 20 && var(VAR_TEMP_1) == 66){
                applymovement(29, ProtestorToRight)
                waitmovement(0)
                applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceUp)
            }
            if (var(VAR_TEMP_0) == 19 && var(VAR_TEMP_1) == 67){
                applymovement(29, ProtestorToBottomRight)
                waitmovement(0)
                applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceLeft)
            }
            waitmovement(0)
            applymovement(30, Common_Movement_FaceLeft)
            waitmovement(0)
            trainerbattle_single(TRAINER_ED, "This can't happen!", "Have you no morals?", Ranch_EventScript_FirstProtesterLeave)

        }
    }
    if (flag(FLAG_FARMER1_BATTLE) == TRUE){
        lock
        faceplayer
        waitmovement(0)
        msgbox(format("Thank you for siding with me. You have saved countless animals from a life of misery.\pAdditionally, the farmers can use their precious water on food they can eat.\pThis is better for everyone."))
        closemessage
    }
    release
    end
}

script Ranch_EventScript_LiberateBattleFarmer{
    if(flag(FLAG_FARMER1_BATTLE) == FALSE){
        lock
        applymovement(30, Common_Movement_WalkInPlaceFastLeft)
        waitmovement(0)
        delay(15)
        msgbox(format("I don't care what your reason is! You can't just go around stealing my chickens!"))
        closemessage
        delay(15)
        applymovement(29, Common_Movement_WalkInPlaceFastRight)
        delay(15)
        msgbox(format("Those are sentient beings who are crammed in a barn all day! They deserve to be free!"))
        closemessage
        delay(15)
        applymovement(30, Common_Movement_WalkInPlaceFastLeft)
        waitmovement(0)
        delay(15)
