            }
            if (var(VAR_TEMP_0) == 18 && var(VAR_TEMP_1) == 65){
                applymovement(29, Common_Movement_FacePlayer)
            }
            if (var(VAR_TEMP_0) == 18 && var(VAR_TEMP_1) == 67){
