script Ranch_EventScript_ThirdFarmerLeave{
    lock
    delay(15)
    applymovement(17, Common_Movement_FaceAwayPlayer)
    waitmovement(0)
    delay(15)
    msgbox(format("I truly don't understand. How have people been growing crops without irrigation?"))
    closemessage
    delay(15)
    applymovement(17, Common_Movement_FacePlayer)
    delay(15)
    msgbox(format("It simply won't work!"))
    closemessage
    delay(15)
    fadescreenswapbuffers(FADE_TO_BLACK)
    removeobject(17)
    playse(SE_EXIT)
    waitse
    setflag(FLAG_PROTEST_WIN_3)
    setflag(FLAG_FARMER3_BATTLE)
    if(flag(FLAG_FARMER1_BATTLE) == TRUE && flag(FLAG_FARMER2_BATTLE) == TRUE && flag(FLAG_FARMER3_BATTLE) == TRUE && flag(FLAG_FARMER4_BATTLE) == TRUE && flag(FLAG_FARMER5_BATTLE) == TRUE && flag(FLAG_FARMER6_BATTLE) == TRUE && flag(FLAG_FARMER7_BATTLE) == TRUE){
        setflag(FLAG_READY_FINAL_RANCH_BATTLE)
        setvar(VAR_RANCH_STATE, 2)
    }
    addvar(VAR_RANCH_MORALITY_SYSTEM, 1)
    applymovement(18, Common_Movement_UnlockFacingDirection)
    waitmovement(0)
    SetObjectMovementType(18, MOVEMENT_TYPE_WANDER_AROUND)
    waitmovement(0)
    setobjectxyperm(18, 36, 50)
    addobject(18)
    waitmovement(0)
    delay(15)
    fadescreenswapbuffers(FADE_FROM_BLACK)
    goto(Ranch_EventScript_ProtestWin3)
    release
    end
}

script Ranch_EventScript_ThirdProtestorLeave{
    lock
    delay(15)
    applymovement(18, Common_Movement_FaceAwayPlayer)
    waitmovement(0)
    delay(15)
    msgbox(format("I just thought you would hear me out."))
    closemessage
    delay(15)
    applymovement(18, FarmerFreakOut)
    playse(SE_BIKE_HOP)
    waitmovement(0)
    applymovement(18, Common_Movement_FacePlayer)
    delay(15)
    msgbox(format("These practices can not last."))
    closemessage
    delay(15)
    fadescreenswapbuffers(FADE_TO_BLACK)
    removeobject(18)
    playse(SE_EXIT)
    waitse
    setflag(FLAG_FARMER_WIN_3)
    setflag(FLAG_FARMER3_BATTLE)
    if(flag(FLAG_FARMER1_BATTLE) == TRUE && flag(FLAG_FARMER2_BATTLE) == TRUE && flag(FLAG_FARMER3_BATTLE) == TRUE && flag(FLAG_FARMER4_BATTLE) == TRUE && flag(FLAG_FARMER5_BATTLE) == TRUE && flag(FLAG_FARMER6_BATTLE) == TRUE && flag(FLAG_FARMER7_BATTLE) == TRUE){
        setflag(FLAG_READY_FINAL_RANCH_BATTLE)
        setvar(VAR_RANCH_STATE, 2)
    }
    subvar(VAR_RANCH_MORALITY_SYSTEM, 1)
    applymovement(17, Common_Movement_UnlockFacingDirection)
    waitmovement(0)
    SetObjectMovementType(17, MOVEMENT_TYPE_WANDER_AROUND)
    waitmovement(0)
    setobjectxyperm(17, 36, 49)
    addobject(17)
    waitmovement(0)
    delay(15)
    fadescreenswapbuffers(FADE_FROM_BLACK)
    goto(Ranch_EventScript_FarmerWin3)
    release
    end
}

movement FarmerMadInPlaceDown{
    walk_in_place_fast_down*3
    walk_in_place_faster_down*5
}

movement ProtestorMadInPlaceUp{
    walk_in_place_fast_up*3
    walk_in_place_faster_up*5
}

movement Farmer3ToRight{
    walk_fast_right
    face_down
}

movement Farmer3ToBottom{
    walk_fast_right
    walk_fast_down*2
    face_left
}

movement Protestor3ToRight{
    walk_fast_right
    face_up
}

movement Protestor3ToTop{
    walk_fast_right
    walk_fast_up*2
    face_left
}

script Ranch_EventScript_DroughtResistantEncounterFarmer{
    if(flag(FLAG_FARMER4_BATTLE) == FALSE){
        lock
        applymovement(19, Common_Movement_WalkInPlaceFastDown)
        waitmovement(0)
        delay(15)
        msgbox(format("This hay represents our entire economy! Who cares how much water it uses, we ain't changing!"))
        closemessage
        delay(15)
        applymovement(20, Common_Movement_WalkInPlaceFastUp)
        delay(15)
        msgbox(format("You can't even eat it! You ship all this hay overseas anyways, it's like you're throwing away your last bits of water. Why not grow food for yourselves that doesn't demand as much water?"))
        closemessage
        delay(15)
        applymovement(19, Common_Movement_WalkInPlaceFastDown)
        waitmovement(0)
        delay(15)
        msgbox(format("You're not listening! What about the economy?"))
        closemessage
        delay(15)
        applymovement(20, Common_Movement_WalkInPlaceFastUp)
        delay(15)
        msgbox(format("Isn't your life more important than money?"))
        closemessage
        delay(15)
        faceplayer
        msgbox(format("What should we grow? Drought-resistant food crops, or hay?"))
        dynmultichoice(0, 0, TRUE, 2, 0, DYN_MULTICHOICE_CB_NONE, "Drought-resistant!", "Hay!")
        if (var(VAR_RESULT) == 0){
            applymovement(20, Common_Movement_LockFacingDirection)
            waitmovement(0)
            applymovement(19, FarmerMadInPlaceDown)
            waitmovement(0)
            delay(15)
            msgbox(format("All I know is hay! I can't change to your weird plants!"))
            closemessage
            getplayerxy(VAR_TEMP_0, VAR_TEMP_1)
            if (var(VAR_TEMP_0) == 66 && var(VAR_TEMP_1) == 36){
                applymovement(19, Common_Movement_FacePlayer)
            }
            if (var(VAR_TEMP_0) == 65 && var(VAR_TEMP_1) == 37){
                applymovement(19, Common_Movement_FacePlayer)
            }
            if (var(VAR_TEMP_0) == 65 && var(VAR_TEMP_1) == 38){
                applymovement(19, Farmer4ToLeft)
                waitmovement(0)
                applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceUp)
            }
            if (var(VAR_TEMP_0) == 66 && var(VAR_TEMP_1) == 39){
                applymovement(19, Farmer4ToBottom)
                waitmovement(0)
                applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceLeft)
            }
            waitmovement(0)
            trainerbattle_single(TRAINER_GRUNT_WEATHER_INST_2, "Just leave us be!", "How are we supposed to make any \nmoney?", Ranch_EventScript_FourthFarmerLeave)
        }
        if (var(VAR_RESULT) == 1){
            applymovement(19, Common_Movement_LockFacingDirection)
            waitmovement(0)
            applymovement(20, ProtestorMadInPlaceUp)
            waitmovement(0)
            delay(15)
            msgbox(format("Isn't eating more important than your economy? You're so short-sighted!"))
            closemessage
            getplayerxy(VAR_TEMP_0, VAR_TEMP_1)
            if (var(VAR_TEMP_0) == 66 && var(VAR_TEMP_1) == 39){
                applymovement(20, Common_Movement_FacePlayer)
            }
            if (var(VAR_TEMP_0) == 65 && var(VAR_TEMP_1) == 38){
                applymovement(20, Common_Movement_FacePlayer)
            }
            if (var(VAR_TEMP_0) == 65 && var(VAR_TEMP_1) == 37){
                applymovement(20, Protestor4ToLeft)
                waitmovement(0)
                applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceUp)
            }
            if (var(VAR_TEMP_0) == 66 && var(VAR_TEMP_1) == 36){
                applymovement(20, Protestor4ToTop)
                waitmovement(0)
                applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceLeft)
            }
            waitmovement(0)
            trainerbattle_single(TRAINER_GRUNT_WEATHER_INST_3, "Stop growing hay!", "Why should we continue to waste water?", Ranch_EventScript_FourthProtestorLeave)
        }
    }
    if(flag(FLAG_FARMER4_BATTLE) == TRUE){
        lock
        faceplayer
        waitmovement(0)
        msgbox(format("I don't understand why these protestors want us to change our ways. This is the way we've always done things around here, they can't just expect us to learn a new way of life!"))
        closemessage
    }
    release
    end
}

