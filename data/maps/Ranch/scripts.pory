            }
            waitmovement(0)
            applymovement(29, Common_Movement_FaceRight)
            waitmovement(0)
            trainerbattle_single(TRAINER_ALBERTO, "I won't let you do this!", "Gah! How could you?", Ranch_EventScript_FirstFarmerLeave)
        }
        if (var(VAR_RESULT) == 1){
            applymovement(30, Common_Movement_LockFacingDirection)
            waitmovement(0)
            applymovement(29, FarmerFreakOut)
            playse(SE_BIKE_HOP)
            waitmovement(0)
