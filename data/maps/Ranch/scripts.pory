script Ranch_EventScript_PesticideEncounterFarmer{
    if(flag(FLAG_FARMER6_BATTLE) == FALSE){
        lock
        applymovement(26, Common_Movement_WalkInPlaceFastRight)
        waitmovement(0)
        delay(15)
        msgbox(format("I understand the riverbed has run dry and there's less risk of water contamination, but you can't recommend these pesticides to the farmers any more!\pYou're slowly killing entire ecosystems!"))
        closemessage
        delay(15)
        applymovement(25, Common_Movement_WalkInPlaceFastLeft)
        delay(15)
        msgbox(format("The farmers need to protect their plants from Bug-Type Pokémon. How else do you recommend they do so?"))
        closemessage
        delay(15)
        applymovement(26, Common_Movement_WalkInPlaceFastRight)
        waitmovement(0)
        delay(15)
        msgbox(format("Encouraging the presence of native predators, like local Flying-Type Pokémon, can help deal with the problems.\pIn any case, spreading carcinogens on their fields is not good for anyone's health."))
        closemessage
        delay(15)
        applymovement(25, Common_Movement_WalkInPlaceFastLeft)
        delay(15)
        msgbox(format("Natural predators? What are you talking about?\pWe have developed a potent solution for this issue. Farmers would be fools not to use it."))
        closemessage
        delay(15)
        faceplayer
        msgbox(format("How should pests be dealt with? Natural solutions, or pesticides?"))
        dynmultichoice(0, 0, TRUE, 2, 0, DYN_MULTICHOICE_CB_NONE, "Natural!", "Pesticides!")
        if (var(VAR_RESULT) == 0){
            applymovement(26, Common_Movement_LockFacingDirection)
            waitmovement(0)
            applymovement(25, FarmerFreakOut)
            waitmovement(0)
            applymovement(25, Common_Movement_FaceLeft)
            waitmovement(0)
            delay(15)
            msgbox(format("Farmers have always had to deal with issues when it comes to nature.\pUsing our technology can solve those problems!"))
            closemessage
            getplayerxy(VAR_TEMP_0, VAR_TEMP_1)
            if (var(VAR_TEMP_0) == 59 && var(VAR_TEMP_1) == 19){
                applymovement(25, Common_Movement_FacePlayer)
            }
            if (var(VAR_TEMP_0) == 58 && var(VAR_TEMP_1) == 19){
                applymovement(25, Farmer6ToLeft)
                waitmovement(0)
                applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceRight)
            }
            waitmovement(0)
            trainerbattle_single(TRAINER_GRUNT_SPACE_CENTER_1, "We have to use the best tools science\nhas to offer!", "Why wouldn't we use technology?", Ranch_EventScript_SixthFarmerLeave)
        }
        if (var(VAR_RESULT) == 1){
            applymovement(25, Common_Movement_LockFacingDirection)
            waitmovement(0)
            applymovement(26, FarmerFreakOut)
            waitmovement(0)
            applymovement(26, Common_Movement_FaceRight)
            waitmovement(0)
            delay(15)
            msgbox(format("You are spreading death! Groundwater, air, soil, everything is being contaminated!"))
            closemessage
            getplayerxy(VAR_TEMP_0, VAR_TEMP_1)
            if (var(VAR_TEMP_0) == 58 && var(VAR_TEMP_1) == 19){
                applymovement(26, Common_Movement_FacePlayer)
            }
            if (var(VAR_TEMP_0) == 59 && var(VAR_TEMP_1) == 19){
                applymovement(26, Protestor6ToRight)
                waitmovement(0)
                applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceLeft)
            }
            waitmovement(0)
            trainerbattle_single(TRAINER_GRUNT_MT_PYRE_1, "I can't stand by and let this happen!", "You are killing the planet.", Ranch_EventScript_SixthProtestorLeave)
        }
    }
    if(flag(FLAG_FARMER6_BATTLE) == TRUE){
        lock
        faceplayer
        waitmovement(0)
        msgbox(format("We need pesticides to ensure a healthy harvest. Thank you for seeing reason."))
        closemessage
    }
    release
    end
}

