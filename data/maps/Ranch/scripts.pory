script Ranch_EventScript_FertilizerEncounterFarmer{
    if(flag(FLAG_FARMER7_BATTLE) == FALSE){
        lock
        applymovement(27, Common_Movement_WalkInPlaceFastRight)
        waitmovement(0)
        delay(15)
        msgbox(format("Chemical fertilizers greatly increases the agricultural potential of a plot of land.\pIt would be silly not to use it!"))
        closemessage
        delay(15)
        applymovement(28, Common_Movement_WalkInPlaceFastLeft)
        delay(15)
        msgbox(format("Maybe so, but they also pollute water, air, and soil. They can also cause ecological disasters, like algal blooms. We can use alternatives!"))
        closemessage
        delay(15)
        applymovement(27, Common_Movement_WalkInPlaceFastRight)
        waitmovement(0)
        delay(15)
        msgbox(format("Oh, really? What alternatives do you propose?"))
        closemessage
        delay(15)
        applymovement(28, Common_Movement_WalkInPlaceFastLeft)
        delay(15)
        msgbox(format("There are natural soil amendments we can use, like compost. If other sustainable practices are used, we won't need fertilizers at all."))
        closemessage
        delay(15)
        faceplayer
        msgbox(format("What do you think we should use? Natural solutions, or fertilizers?"))
        dynmultichoice(0, 0, TRUE, 2, 0, DYN_MULTICHOICE_CB_NONE, "Natural!", "Fertilizers!")
        if (var(VAR_RESULT) == 0){
            applymovement(28, Common_Movement_LockFacingDirection)
            waitmovement(0)
            applymovement(27, FarmerMadInPlaceRight)
            waitmovement(0)
            delay(15)
            msgbox(format("We have developed solutions for our world's greatest problems. They must be used!"))
            closemessage
            getplayerxy(VAR_TEMP_0, VAR_TEMP_1)
            if (var(VAR_TEMP_0) == 26 && var(VAR_TEMP_1) == 49){
                applymovement(27, Common_Movement_FacePlayer)
            }
            if (var(VAR_TEMP_0) == 27 && var(VAR_TEMP_1) == 49){
                applymovement(27, Farmer7ToRight)
                waitmovement(0)
                applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceLeft)
            }
            waitmovement(0)
            trainerbattle_single(TRAINER_GRUNT_MT_PYRE_2, "I will fight for science!", "Chemicals cause no harm.", Ranch_EventScript_SeventhFarmerLeave)
        }
        if (var(VAR_RESULT) == 1){
            applymovement(27, Common_Movement_LockFacingDirection)
            waitmovement(0)
            applymovement(28, ProtestorMadInPlaceLeft)
            waitmovement(0)
            delay(15)
            msgbox(format("Fertilizers lead us down a path to ruin."))
            closemessage
            getplayerxy(VAR_TEMP_0, VAR_TEMP_1)
            if (var(VAR_TEMP_0) == 27 && var(VAR_TEMP_1) == 49){
                applymovement(28, Common_Movement_FacePlayer)
            }
            if (var(VAR_TEMP_0) == 26 && var(VAR_TEMP_1) == 49){
                applymovement(28, Protestor7ToLeft)
                waitmovement(0)
                applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceRight)
            }
            waitmovement(0)
            trainerbattle_single(TRAINER_GRUNT_MT_PYRE_3, "We will all suffer because of this!", "Why do you insist upon using \nchemicals?", Ranch_EventScript_SeventhProtestorLeave)
        }
    }
    if(flag(FLAG_FARMER7_BATTLE) == TRUE){
        lock
        faceplayer
        waitmovement(0)
        msgbox(format("Fertilizer is a scientific miracle that has saved millions, if not billions, of lives.\pIt must be used."))
        closemessage
    }
    release
    end
}

