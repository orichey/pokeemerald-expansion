    release
}



movement MomLook {
    face_left
}

movement MomMove {
    walk_right
    face_left
}

movement GoToTV {
    walk_right
    walk_down
    walk_right*2
    face_up
}

movement GoToTVFromLeft {
    walk_right*3
    walk_down
    walk_right*2
    face_up
}

movement LookRight {
    face_right
}

movement LookToMom {
    face_right
}

movement MomLookUp {
    face_up
}