	applymovement(8, Common_Movement_FaceOriginalDirection)
	waitmovement(0)
	release
	end
}

script Route103_EventScript_DoubleBattlePartOne {
    trainerbattle_single(TRAINER_GRUNT_AQUA_HIDEOUT_1, IntroText_Francis, LoseText_Francis)
	msgbox(PostBattle_OldCouple1, MSGBOX_AUTOCLOSE) 
	waitmessage
    end
}

script Route103_EventScript_DoubleBattlePartTwo {
	trainerbattle_single(TRAINER_SAWYER_1, IntroText_George, LoseText_George)
	msgbox(PostBattle_OldCouple2, MSGBOX_AUTOCLOSE) 
	waitmessage
    end
}

script Route103_EventScript_HidingBugTrainer {
	trainerbattle_single(TRAINER_GRUNT_AQUA_HIDEOUT_2, IntroText_Jonny, LoseText_Jonny)
	msgbox(PostBattle_Jonny, MSGBOX_AUTOCLOSE) 
	waitmessage
    end
}

script Route103_EventScript_KingTrainer {
	trainerbattle_single(TRAINER_GRUNT_AQUA_HIDEOUT_3, IntroText_Kingston, LoseText_Kingston)
	msgbox(PostBattle_Kingston, MSGBOX_AUTOCLOSE) 
	waitmessage
    end
}

text IntroText_Kingston{
	format("My Pokémon are strong against water. I feel like I'm the king of the hill!")
}

text LoseText_Kingston{
	format("You've dethroned me!")
}

text PostBattle_Kingston{
	format("Even though my Pokémon are successful, this sea level rise can't possibly be a good thing.\pThe environment that was here previously has been destroyed!")
}

script Route103_EventScript_ScaryFlooding {
	trainerbattle_single(TRAINER_GRUNT_SEAFLOOR_CAVERN_2, IntroText_Terry, LoseText_Terry)
	msgbox(PostBattle_Terry, MSGBOX_AUTOCLOSE) 
	waitmessage
    end
}

text IntroText_Terry{
	format("This flooding is scary!")
}

text LoseText_Terry{
	format("You're strong!")
}

text PostBattle_Terry{
	format("Even I can remember a time when I could walk from Treefall City to Seaspray Town./pThat doesn't seem possible any more!")
}

text IntroText_Jonny{
	format("Hah!\nI bet you didn't see me!")
}

text LoseText_Jonny{
	format("Huh, you were ready!")
}

text PostBattle_Jonny{
	format("There's a storm ahead. Good thing my Pokémon like the rain!")
}

text IntroText_George{
	format("We escaped, why are you going south?")
}
text IntroText_Francis{
	format("Disaster lies ahead!")
}
text LoseText_George{
    format("You're strong!")
}
text LoseText_Francis{
    format("Wow, maybe you can handle the storm!")
}
text PostBattle_OldCouple1{
    format("We escaped from Seaspray Town. We don't see many people heading there.")
}
text PostBattle_OldCouple2{
    format("I've never seen such stormy conditions. Hopefully the rain lets up soon.")
}

script Route103_EventScript_Hiker1 {
	trainerbattle_single(TRAINER_GRUNT_SEAFLOOR_CAVERN_3, IntroText_Mark, LoseText_Mark)
	msgbox(PostBattle_Mark, MSGBOX_AUTOCLOSE) 
	waitmessage
    end
}

text IntroText_Mark{
	format("These cliffs are steep!")
}

text LoseText_Mark{
	format("Wahahaha!")
}

text PostBattle_Mark{
	format("Not many are able to scale these mountains.\pPeople are trapped in Seaspray Town!")
}

